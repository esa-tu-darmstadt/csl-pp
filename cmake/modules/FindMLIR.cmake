# csl-mlir has one standalone build path using an installed Conan dependency.
find_package(MLIR REQUIRED CONFIG)
find_package(Python3 REQUIRED COMPONENTS Interpreter)
include("${CSL_MLIR_SOURCE_DIR}/cmake/VerifyLLVM.cmake")
if(NOT CSL_LLVM_REVISION)
  message(FATAL_ERROR "Use scripts/conan-build.py to select the LLVM gitlink package.")
endif()
csl_verify_llvm_revision("${CSL_LLVM_REVISION}")
message(STATUS "Using pinned MLIRConfig.cmake in: ${MLIR_DIR}")
set(LLVM_RUNTIME_OUTPUT_INTDIR "${CSL_MLIR_BINARY_DIR}/bin")
set(LLVM_LIBRARY_OUTPUT_INTDIR "${CSL_MLIR_BINARY_DIR}/lib")
set(CMAKE_RUNTIME_OUTPUT_DIRECTORY "${LLVM_RUNTIME_OUTPUT_INTDIR}")
set(CMAKE_LIBRARY_OUTPUT_DIRECTORY "${LLVM_LIBRARY_OUTPUT_INTDIR}")
set(CMAKE_ARCHIVE_OUTPUT_DIRECTORY "${LLVM_LIBRARY_OUTPUT_INTDIR}")
set(MLIR_BINARY_DIR "${CSL_MLIR_BINARY_DIR}")
set(LLVM_TOOLS_DIR "${LLVM_TOOLS_BINARY_DIR}")
set(LLVM_BUILD_MODE "")
list(APPEND CMAKE_MODULE_PATH "${MLIR_CMAKE_DIR}" "${LLVM_CMAKE_DIR}")
include(TableGen)
include(AddLLVM)
include(AddMLIR)
include(HandleLLVMOptions)
