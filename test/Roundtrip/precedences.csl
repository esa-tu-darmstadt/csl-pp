// RUN: csl-s2s %s -verify-diagnostics --split-input-file | FileCheck %s

// =============================================================================
// Bitwise operators have equal precedence in CSL (left-to-right).
// `a | b & c` parses as `(a | b) & c`, NOT `a | (b & c)`.
// The emitter must NOT rely on & > | precedence.
// =============================================================================

// CHECK: export fn test_bitwise_ltr(param0: u32, param1: u32, param2: u32) u32 {
// CHECK:     return param0 | param1 & param2;
// CHECK: }
export fn test_bitwise_ltr(a: u32, b: u32, c: u32) u32 {
    // Parsed left-to-right as (a | b) & c.
    // Emitted without extra parens because CSL's left-to-right rule
    // already gives the correct grouping for the LHS.
    return a | b & c;
}

// -----

// =============================================================================
// When & appears as the RHS of |, it needs explicit parens so that
// CSL's left-to-right rule doesn't absorb it into the left group.
// `a & b | (c & d)` is the correct emission of `or(and(a,b), and(c,d))`.
// =============================================================================

// CHECK: export fn test_bitwise_rhs_parens(param0: u32, param1: u32, param2: u32, param3: u32) u32 {
// CHECK:     return param0 & param1 | (param2 & param3);
// CHECK: }
export fn test_bitwise_rhs_parens(a: u32, b: u32, c: u32, d: u32) u32 {
    // Explicit parens in source ensure (a&b)|(c&d). The emitter must
    // preserve the RHS grouping with parens.
    return (a & b) | (c & d);
}
