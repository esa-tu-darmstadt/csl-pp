// RUN: csl-s2s %s -verify-diagnostics --split-input-file | FileCheck %s

// =============================================================================
// Basic for loop with range
// =============================================================================

// CHECK: export fn sum_range() i32 {
// CHECK:     var sum: i32 = @as(i32, 0);
// CHECK:     for (@range(i32, 0, 10, 1)) |i| {
// CHECK:         sum += i;
// CHECK:     }
// CHECK:     return sum;
// CHECK: }
export fn sum_range() i32 {
    var sum: i32 = 0;
    for (@range(i32, 0, 10, 1)) |i| {
        sum += i;
    }
    return sum;
}

// -----

// =============================================================================
// For loop with range and index
// =============================================================================

// CHECK: export fn range_with_index() i32 {
// CHECK:     var sum: i32 = @as(i32, 0);
// CHECK:     for (@range(i32, 100, 105, 1)) |elem, idx| {
// CHECK:         sum = sum + elem + @as(i32, idx);
// CHECK:     }
// CHECK:     return sum;
// CHECK: }
export fn range_with_index() i32 {
    var sum: i32 = 0;
    for (@range(i32, 100, 105, 1)) |elem, idx| {
        sum = sum + elem + @as(i32, idx);
    }
    return sum;
}

// -----

// =============================================================================
// For loop with array
// =============================================================================

// CHECK: export fn sum_array([[arr:.*]]: *const [5]i32) i32 {
// CHECK:     var sum: i32 = @as(i32, 0);
// CHECK:     for ([[arr]].*) |elem| {
// CHECK:         sum += elem;
// CHECK:     }
// CHECK:     return sum;
// CHECK: }
export fn sum_array(arr: *const [5]i32) i32 {
    var sum: i32 = 0;
    for (arr.*) |elem| {
        sum += elem;
    }
    return sum;
}

// -----

// =============================================================================
// For loop with array and index
// =============================================================================

// CHECK: export fn weighted_sum([[arr:.*]]: *const [4]i32) i32 {
// CHECK:     var sum: i32 = @as(i32, 0);
// CHECK:     for ([[arr]].*) |elem, idx| {
// CHECK:         sum += elem * @as(i32, idx);
// CHECK:     }
// CHECK:     return sum;
// CHECK: }
export fn weighted_sum(arr: *const [4]i32) i32 {
    var sum: i32 = 0;
    for (arr.*) |elem, idx| {
        sum += elem * @as(i32, idx);
    }
    return sum;
}

// -----

// =============================================================================
// Inline for loop with range - expanded at comptime
// =============================================================================

// CHECK: export fn inline_range_sum() i32 {
// CHECK:     var sum: i32 = @as(i32, 0);
// CHECK:     sum += @as(i32, 0);
// CHECK:     sum += @as(i32, 1);
// CHECK:     sum += @as(i32, 2);
// CHECK:     sum += @as(i32, 3);
// CHECK:     sum += @as(i32, 4);
// CHECK:     return sum;
// CHECK: }
export fn inline_range_sum() i32 {
    var sum: i32 = 0;
    inline for (@range(i32, 0, 5, 1)) |i| {
        sum += i;
    }
    return sum;
}

// -----

// =============================================================================
// Inline for loop with range and index
// =============================================================================

// CHECK: export fn inline_range_with_index() i32 {
// CHECK:     var sum: i32 = @as(i32, 0);
// CHECK:     sum = sum + @as(i32, 10) + @as(i32, 0);
// CHECK:     sum = sum + @as(i32, 12) + @as(i32, 1);
// CHECK:     sum = sum + @as(i32, 14) + @as(i32, 2);
// CHECK:     return sum;
// CHECK: }
export fn inline_range_with_index() i32 {
    var sum: i32 = 0;
    inline for (@range(i32, 10, 16, 2)) |elem, idx| {
        sum = sum + elem + @as(i32, idx);
    }
    return sum;
}

// -----

// =============================================================================
// Inline for loop with comptime array
// =============================================================================

const ct_arr = [3]i32{ 100, 200, 300 };

// CHECK: export fn inline_comptime_array() i32 {
// CHECK:     var sum: i32 = @as(i32, 0);
// CHECK:     sum += @as(i32, 100);
// CHECK:     sum += @as(i32, 200);
// CHECK:     sum += @as(i32, 300);
// CHECK:     return sum;
// CHECK: }
export fn inline_comptime_array() i32 {
    var sum: i32 = 0;
    inline for (ct_arr) |elem| {
        sum += elem;
    }
    return sum;
}

// -----

// =============================================================================
// Inline for loop with comptime function argument
// =============================================================================

fn scale(comptime factor: i32, x: i32) i32 {
    return x * factor;
}

// CHECK: export fn inline_for_comptime_arg([[p:.*]]: i32) i32 {
// CHECK:     var sum: i32 = @as(i32, 0);
// CHECK:     sum += scale_inst{{[0-9]+}}([[p]]);
// CHECK:     sum += scale_inst{{[0-9]+}}([[p]]);
// CHECK:     sum += scale_inst{{[0-9]+}}([[p]]);
// CHECK:     return sum;
// CHECK: }
export fn inline_for_comptime_arg(x: i32) i32 {
    var sum: i32 = 0;
    inline for (@range(i32, 1, 4, 1)) |i| {
        sum += scale(i, x);
    }
    return sum;
}

// -----

// =============================================================================
// For loop with break
// =============================================================================

// CHECK: export fn sum_until_negative([[arr:.*]]: *const [10]i32) i32 {
// CHECK:     var sum: i32 = @as(i32, 0);
// CHECK:     for ([[arr]].*) |elem| {
// CHECK:         if (elem < @as(i32, 0))
// CHECK:             break;
// CHECK:         sum += elem;
// CHECK:     }
// CHECK:     return sum;
// CHECK: }
export fn sum_until_negative(arr: *const [10]i32) i32 {
    var sum: i32 = 0;
    for (arr.*) |elem| {
        if (elem < 0) {
            break;
        }
        sum += elem;
    }
    return sum;
}

// -----

// =============================================================================
// For loop with continue
// =============================================================================

// CHECK: export fn sum_positive([[arr:.*]]: *const [10]i32) i32 {
// CHECK:     var sum: i32 = @as(i32, 0);
// CHECK:     for ([[arr]].*) |elem| {
// CHECK:         if (elem < @as(i32, 0))
// CHECK:             continue;
// CHECK:         sum += elem;
// CHECK:     }
// CHECK:     return sum;
// CHECK: }
export fn sum_positive(arr: *const [10]i32) i32 {
    var sum: i32 = 0;
    for (arr.*) |elem| {
        if (elem < 0) {
            continue;
        }
        sum += elem;
    }
    return sum;
}

// -----

// =============================================================================
// Labeled for loop with break
// =============================================================================

// CHECK: export fn find_value([[rows:.*]]: *const [5]i32, [[cols:.*]]: *const [5]i32, [[target:.*]]: i32) bool {
// CHECK:     outer: for ([[rows]].*) |row| {
// CHECK:         for ([[cols]].*) |col| {
// CHECK:             if (row + col == [[target]])
// CHECK:                 break :outer;
// CHECK:         }
// CHECK:     }
// CHECK:     return false;
// CHECK: }
export fn find_value(rows: *const [5]i32, cols: *const [5]i32, target: i32) bool {
    outer: for (rows.*) |row| {
        for (cols.*) |col| {
            if (row + col == target) {
                break :outer;
            }
        }
    }
    return false;
}

// -----

// =============================================================================
// For loop with range step != 1
// =============================================================================

// CHECK: export fn sum_evens() i32 {
// CHECK:     var sum: i32 = @as(i32, 0);
// CHECK:     for (@range(i32, 0, 10, 2)) |i| {
// CHECK:         sum += i;
// CHECK:     }
// CHECK:     return sum;
// CHECK: }
export fn sum_evens() i32 {
    var sum: i32 = 0;
    for (@range(i32, 0, 10, 2)) |i| {
        sum += i;
    }
    return sum;
}
