// RUN: csl-s2s %s -verify-diagnostics --split-input-file | FileCheck %s

// =============================================================================
// Constant true condition: select returns then-value
// =============================================================================

// CHECK: export fn select_const_true(param0: i32, param1: i32) i32 {
// CHECK:     return param0;
// CHECK: }
export fn select_const_true(a: i32, b: i32) i32 {
    return if (true) a else b;
}

// -----

// =============================================================================
// Constant false condition: select returns else-value
// =============================================================================

// CHECK: export fn select_const_false(param0: i32, param1: i32) i32 {
// CHECK:     return param1;
// CHECK: }
export fn select_const_false(a: i32, b: i32) i32 {
    return if (false) a else b;
}
