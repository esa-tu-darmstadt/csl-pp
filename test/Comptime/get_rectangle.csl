// RUN: csl-s2s %s --rectangle=4,3 --fabric-dims=8,8 --fabric-offsets=1,2 --verify-diagnostics --split-input-file

// =============================================================================
// Test @get_rectangle builtin with all options
// =============================================================================

comptime {
  const rect = @get_rectangle();

  // Rectangle dimensions
  // expected-remark @+1 {{4}}
  @comptime_print(rect.width);
  // expected-remark @+1 {{3}}
  @comptime_print(rect.height);

  // Fabric dimensions
  // expected-remark @+1 {{8}}
  @comptime_print(rect.fabric.width);
  // expected-remark @+1 {{8}}
  @comptime_print(rect.fabric.height);

  // Offsets
  // expected-remark @+1 {{1}}
  @comptime_print(rect.offsets.width);
  // expected-remark @+1 {{2}}
  @comptime_print(rect.offsets.height);
}

// -----

// =============================================================================
// Test @get_rectangle in expressions
// =============================================================================

comptime {
  const rect = @get_rectangle();

  // Use rectangle dimensions in expressions
  const area = rect.width * rect.height;
  // expected-remark @+1 {{12}}
  @comptime_print(area);

  // Use fabric dimensions
  const fabric_area = rect.fabric.width * rect.fabric.height;
  // expected-remark @+1 {{64}}
  @comptime_print(fabric_area);
}

// -----

// =============================================================================
// Test @get_rectangle concrete field types
// =============================================================================

comptime {
  const rect = @get_rectangle();
  @comptime_assert(@is_same_type(@type_of(rect.width), u16));
  @comptime_assert(@is_same_type(@type_of(rect.height), u16));
  @comptime_assert(@is_same_type(@type_of(rect.fabric.width), u16));
  @comptime_assert(@is_same_type(@type_of(rect.offsets.height), u16));
}

// -----

// =============================================================================
// Test @get_rectangle can be called from runtime function
// =============================================================================

fn get_rect_width() u16 {
  const rect = @get_rectangle();
  return rect.width;
}

export fn main() void {
  const w = get_rect_width();
}
