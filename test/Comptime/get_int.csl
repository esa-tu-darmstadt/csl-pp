// RUN: csl-s2s %s --split-input-file -verify-diagnostics

// =============================================================================
// @get_int with all supported types
// =============================================================================

const my_enum = enum(u32) { A = 10, B = 20 };

comptime {
    // Enum
    // expected-remark @+1 {{10}}
    @comptime_print(@get_int(my_enum.A));
    // expected-remark @+1 {{20}}
    @comptime_print(@get_int(my_enum.B));

    // Color
    const c = @get_color(5);
    // expected-remark @+1 {{5}}
    @comptime_print(@get_int(c));

    // LocalTaskId
    const ltid = @get_local_task_id(42);
    // expected-remark @+1 {{42}}
    @comptime_print(@get_int(ltid));

    // ControlTaskId
    const ctid = @get_control_task_id(7);
    // expected-remark @+1 {{7}}
    @comptime_print(@get_int(ctid));

    // InputQueue
    const iq = @get_input_queue(3);
    // expected-remark @+1 {{3}}
    @comptime_print(@get_int(iq));

    // OutputQueue
    const oq = @get_output_queue(4);
    // expected-remark @+1 {{4}}
    @comptime_print(@get_int(oq));

    // DataTaskId from color
    const dtid = @get_data_task_id(c);
    // expected-remark @+1 {{5}}
    @comptime_print(@get_int(dtid));

    // UtId (microthread ID)
    const uid = @get_ut_id(99);
    // expected-remark @+1 {{99}}
    @comptime_print(@get_int(uid));

    // Integer passthrough (i16)
    const i: i16 = -5;
    // expected-remark @+1 {{-5}}
    @comptime_print(@get_int(i));

    // Integer passthrough (u32)
    const u: u32 = 12345;
    // expected-remark @+1 {{12345}}
    @comptime_print(@get_int(u));
}

// -----

// =============================================================================
// @get_int type checking with @type_of and @is_same_type
// =============================================================================

const my_enum2 = enum(i8) { X = -1, Y = 127 };

comptime {
    // Enum returns underlying type
    const enum_val = @get_int(my_enum2.X);
    // expected-remark @+1 {{true}}
    @comptime_print(@is_same_type(@type_of(enum_val), i8));
    // expected-remark @+1 {{-1}}
    @comptime_print(enum_val);

    // Integer returns same type
    const int_val: i32 = 100;
    const int_result = @get_int(int_val);
    // expected-remark @+1 {{true}}
    @comptime_print(@is_same_type(@type_of(int_result), i32));

    // Color returns u16
    const color_int = @get_int(@get_color(10));
    // expected-remark @+1 {{true}}
    @comptime_print(@is_same_type(@type_of(color_int), u16));

    // LocalTaskId returns u16
    const ltid_int = @get_int(@get_local_task_id(20));
    // expected-remark @+1 {{true}}
    @comptime_print(@is_same_type(@type_of(ltid_int), u16));

    // UtId returns u16
    const utid_int = @get_int(@get_ut_id(30));
    // expected-remark @+1 {{true}}
    @comptime_print(@is_same_type(@type_of(utid_int), u16));
}

// -----

// =============================================================================
// @get_ut_id basic test
// =============================================================================

comptime {
    const ut1 = @get_ut_id(0);
    const ut2 = @get_ut_id(65535);

    // expected-remark @+1 {{0}}
    @comptime_print(@get_int(ut1));
    // expected-remark @+1 {{65535}}
    @comptime_print(@get_int(ut2));
}
