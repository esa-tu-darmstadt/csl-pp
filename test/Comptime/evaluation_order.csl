// RUN: csl-s2s %s -verify-diagnostics --count-tasks=false | FileCheck %s
//
// A variable is read where the source reads it, also at comptime: operands
// are evaluated left to right, so an expression block between two reads of
// a variable runs after the first read and before the second.

comptime {
  var c: i32 = 1;
  const t = .{ c, blk: { c += 10; break :blk @as(i32, 0); }, c };
  // expected-remark @+1 {{1}}
  @comptime_print(t[0]);
  // expected-remark @+1 {{11}}
  @comptime_print(t[2]);

  var d: i32 = 1;
  const s = d + blk2: { d += 10; break :blk2 @as(i32, 0); } + d;
  // expected-remark @+1 {{12}}
  @comptime_print(s);
}

var out: [4]i32;
fn sink(v: i32) void { out[0] = v; }

// A comptime variable that runtime code reads takes the value it has where
// it is read.
// CHECK-LABEL: export fn comptime_var_reads() void {
// CHECK-NEXT:    sink(@as(i32, 1));
// CHECK-NEXT:    sink(@as(i32, 2));
// CHECK-NEXT:    (out)[@as(u16, 0)] = @as(i32, 2);
// CHECK-NEXT:    (out)[@as(u16, 1)] = @as(i32, 12);
export fn comptime_var_reads() void {
  comptime var c: i32 = 1;
  sink(c);
  c = 2;
  sink(c);
  const t = .{ c, blk: { c += 10; break :blk @as(i32, 0); }, c };
  out[0] = t[0];
  out[1] = t[2];
}

var x: i32 = 0;
fn h() i32 { x += 1; return 0; }
inline fn sum(a: i32, b: i32) i32 { return a + b; }

// The arguments of an inline call are read before its body runs: x before
// h() changes it.
// CHECK-LABEL: export fn inline_call_arguments() i32 {
// CHECK-NEXT:    const [[A:__inline_sum_[0-9]+_a]]: i32 = x;
// CHECK-NEXT:    const [[B:__inline_sum_[0-9]+_b]]: i32 = h();
// CHECK-NEXT:    return [[A]] + [[B]];
export fn inline_call_arguments() i32 {
  return sum(x, h());
}
