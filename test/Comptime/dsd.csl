// -----

// =============================================================================
// fifo_dsd - Basic FIFO allocation
// =============================================================================

var fifo_buf: [32]i16;
const fifo = @allocate_fifo(fifo_buf);

comptime {
    // expected-remark @+1 {{fifo_handle}}
    @comptime_print(@type_of(fifo));
}

// -----

// =============================================================================
// fifo_dsd - With priority and task handlers
// =============================================================================

task push_task() void {}
task pop_task() void {}

var fifo_buf2: [64]i16;
const fifo_full = @allocate_fifo(fifo_buf2, .{
    .priority = .{ .high = true },
    .activate_push = push_task,
    .activate_pop = pop_task
});

comptime {
    // expected-remark @+1 {{fifo_handle}}
    @comptime_print(@type_of(fifo_full));
}

// -----

// =============================================================================
// tensor_access const base is allowed
// =============================================================================

const const_arr: [10]u16 = @zeros([10]u16);
comptime {
    const good = |i|{10} -> const_arr[i];
    // expected-remark @+1 {{&const_arr}}
    @comptime_print(good.base_address);
}

// -----

// =============================================================================
// ERROR: tensor_access extent must be comptime-known
// =============================================================================

var arr_runtime: [20]u16;

fn get_runtime_extent() u16 {
    return 10;
}

export fn test_runtime_extent() void {
    const n = get_runtime_extent();
    // expected-error @+1 {{tensor_access extent must be comptime-known}}
    const bad = |i|{n} -> arr_runtime[i];
}

// -----

// =============================================================================
// ERROR: @get_dsd requires tensor_access or explicit properties for mem DSDs
// =============================================================================

comptime {
    // expected-error @+1 {{mem1d_dsd requires tensor_access or explicit base_address, extent, stride}}
    const bad = @get_dsd(mem1d_dsd, .{});
}

// -----

// =============================================================================
// ERROR: fabric DSDs require a fabric endpoint
// =============================================================================

comptime {
    // expected-error @+1 {{fabin_dsd requires fabric_color or input_queue}}
    const bad = @get_dsd(fabin_dsd, .{ .extent = 10 });
}

// -----

// =============================================================================
// ERROR: fabric DSDs require extent
// =============================================================================

comptime {
    // expected-error @+1 {{fabin_dsd requires extent}}
    const bad = @get_dsd(fabin_dsd, .{ .fabric_color = @get_color(0) });
}

// -----

// =============================================================================
// @set_dsd_stride - Modify stride of a mem1d_dsd
// =============================================================================

var arr_stride: [10]u16;
const dsd_for_stride = @get_dsd(mem1d_dsd, .{
    .tensor_access = |i|{10} -> arr_stride[i]
});
const dsd_stride2 = @set_dsd_stride(dsd_for_stride, 2);

comptime {
    // expected-remark @+1 {{@get_dsd(mem1d_dsd, .{ .base_address = &arr_stride, .offset = 0, .stride = 2, .extent = 10 })}}
    @comptime_print(dsd_stride2);
}

// -----

// =============================================================================
// @set_dsd_length - Modify extent of a mem1d_dsd
// =============================================================================

var arr_len: [20]u16;
const dsd_for_len = @get_dsd(mem1d_dsd, .{
    .tensor_access = |i|{20} -> arr_len[i]
});
const dsd_len5 = @set_dsd_length(dsd_for_len, 5);

comptime {
    // expected-remark @+1 {{@get_dsd(mem1d_dsd, .{ .base_address = &arr_len, .offset = 0, .stride = 1, .extent = 5 })}}
    @comptime_print(dsd_len5);
}

// -----

// =============================================================================
// @set_dsd_length - Modify extent of a fabin_dsd
// =============================================================================

const fabin_for_len = @get_dsd(fabin_dsd, .{
    .extent = 10,
    .fabric_color = @get_color(0)
});
const fabin_len5 = @set_dsd_length(fabin_for_len, 5);

comptime {
    // expected-remark @+1 {{@get_dsd(fabin_dsd, .{ .extent = 5, .fabric_color = @get_color(0) })}}
    @comptime_print(fabin_len5);
}

// -----

// =============================================================================
// @set_dsd_length - Modify extent of a fabout_dsd
// =============================================================================

const fabout_for_len = @get_dsd(fabout_dsd, .{
    .extent = 10,
    .fabric_color = @get_color(1)
});
const fabout_len5 = @set_dsd_length(fabout_for_len, 5);

comptime {
    // expected-remark @+1 {{@get_dsd(fabout_dsd, .{ .extent = 5, .fabric_color = @get_color(1) })}}
    @comptime_print(fabout_len5);
}

// -----

// =============================================================================
// @set_dsd_base_addr - Modify base address of a mem1d_dsd
// =============================================================================

var arr_base1: [10]u16;
var arr_base2: [10]u16;
const dsd_for_base = @get_dsd(mem1d_dsd, .{
    .tensor_access = |i|{10} -> arr_base1[i]
});
const dsd_new_base = @set_dsd_base_addr(dsd_for_base, &arr_base2);

comptime {
    // expected-remark @+1 {{@get_dsd(mem1d_dsd, .{ .base_address = &arr_base2, .offset = 0, .stride = 1, .extent = 10 })}}
    @comptime_print(dsd_new_base);
}

// -----

// =============================================================================
// @increment_dsd_offset - Increment offset of a mem1d_dsd
// =============================================================================

var arr_off: [20]u16;
const dsd_for_off = @get_dsd(mem1d_dsd, .{
    .tensor_access = |i|{10} -> arr_off[i]
});
const dsd_off5 = @increment_dsd_offset(dsd_for_off, 5, u16);

comptime {
    // expected-remark @+1 {{@get_dsd(mem1d_dsd, .{ .base_address = &arr_off, .offset = 5, .stride = 1, .extent = 10 })}}
    @comptime_print(dsd_off5);
}
