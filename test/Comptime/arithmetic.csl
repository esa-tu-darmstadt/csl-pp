// RUN: csl-s2s %s -verify-diagnostics --split-input-file

// =============================================================================
// Basic comptime_int arithmetic
// =============================================================================

comptime {
  // Addition
  // expected-remark @+1 {{30}}
  @comptime_print(10 + 20);

  // Subtraction
  // expected-remark @+1 {{5}}
  @comptime_print(15 - 10);

  // Multiplication
  // expected-remark @+1 {{50}}
  @comptime_print(5 * 10);

  // Division
  // expected-remark @+1 {{4}}
  @comptime_print(20 / 5);

  // Modulo
  // expected-remark @+1 {{1}}
  @comptime_print(10 % 3);
}

// -----

// =============================================================================
// Unary negation
// =============================================================================

comptime {
  // expected-remark @+1 {{-42}}
  @comptime_print(-42);

  // Double negation
  // expected-remark @+1 {{42}}
  @comptime_print(-(-42));

  // Negation of expression
  // expected-remark @+1 {{-15}}
  @comptime_print(-(10 + 5));
}

// -----

// =============================================================================
// Logical NOT
// =============================================================================

comptime {
  // expected-remark @+1 {{false}}
  @comptime_print(!true);

  // expected-remark @+1 {{true}}
  @comptime_print(!false);

  // Double negation
  // expected-remark @+1 {{true}}
  @comptime_print(!!true);
}

// -----

// =============================================================================
// Comparison operators
// =============================================================================

comptime {
  // Equal
  // expected-remark @+1 {{true}}
  @comptime_print(10 == 10);
  // expected-remark @+1 {{false}}
  @comptime_print(10 == 20);

  // Not equal
  // expected-remark @+1 {{false}}
  @comptime_print(10 != 10);
  // expected-remark @+1 {{true}}
  @comptime_print(10 != 20);

  // Less than
  // expected-remark @+1 {{true}}
  @comptime_print(5 < 10);
  // expected-remark @+1 {{false}}
  @comptime_print(10 < 5);

  // Less than or equal
  // expected-remark @+1 {{true}}
  @comptime_print(5 <= 10);
  // expected-remark @+1 {{true}}
  @comptime_print(10 <= 10);

  // Greater than
  // expected-remark @+1 {{true}}
  @comptime_print(10 > 5);
  // expected-remark @+1 {{false}}
  @comptime_print(5 > 10);

  // Greater than or equal
  // expected-remark @+1 {{true}}
  @comptime_print(10 >= 5);
  // expected-remark @+1 {{true}}
  @comptime_print(10 >= 10);
}

// -----

// =============================================================================
// Logical AND and OR
// =============================================================================

comptime {
  // AND
  // expected-remark @+1 {{true}}
  @comptime_print(true and true);
  // expected-remark @+1 {{false}}
  @comptime_print(true and false);
  // expected-remark @+1 {{false}}
  @comptime_print(false and true);
  // expected-remark @+1 {{false}}
  @comptime_print(false and false);

  // OR
  // expected-remark @+1 {{true}}
  @comptime_print(true or true);
  // expected-remark @+1 {{true}}
  @comptime_print(true or false);
  // expected-remark @+1 {{true}}
  @comptime_print(false or true);
  // expected-remark @+1 {{false}}
  @comptime_print(false or false);
}

// -----

// =============================================================================
// Bitwise operations
// =============================================================================

comptime {
  // Bitwise AND
  // expected-remark @+1 {{8}}
  @comptime_print(12 & 10);

  // Bitwise OR
  // expected-remark @+1 {{14}}
  @comptime_print(12 | 10);

  // Bitwise XOR
  // expected-remark @+1 {{6}}
  @comptime_print(12 ^ 10);

  // Bitwise NOT (complement)
  // expected-remark @+1 {{-1}}
  @comptime_print(~0);
}

// -----

// =============================================================================
// Shift operations (comptime_int)
// =============================================================================

comptime {
  // Left shift
  // expected-remark @+1 {{8}}
  @comptime_print(1 << 3);
  // expected-remark @+1 {{32}}
  @comptime_print(4 << 3);

  // Right shift
  // expected-remark @+1 {{2}}
  @comptime_print(8 >> 2);
  // expected-remark @+1 {{4}}
  @comptime_print(16 >> 2);
}

// -----

// =============================================================================
// Complex expressions
// =============================================================================

comptime {
  // Arithmetic with parentheses
  // expected-remark @+1 {{14}}
  @comptime_print((2 + 3) * 4 - 6);

  // Mixed comparisons
  // expected-remark @+1 {{true}}
  @comptime_print((5 + 5) == 10);

  // Logical with comparisons
  // expected-remark @+1 {{true}}
  @comptime_print((10 > 5) and (3 < 7));
  // expected-remark @+1 {{false}}
  @comptime_print((10 < 5) or (3 > 7));
}

// -----

// =============================================================================
// Comptime variables with arithmetic
// =============================================================================

comptime {
  var x = 10;
  var y = 20;
  x = x + y;
  // expected-remark @+1 {{30}}
  @comptime_print(x);

  y = x * 2;
  // expected-remark @+1 {{60}}
  @comptime_print(y);

  var z = y - x;
  // expected-remark @+1 {{30}}
  @comptime_print(z);
}

// -----

// =============================================================================
// Negative numbers
// =============================================================================

comptime {
  // expected-remark @+1 {{-10}}
  @comptime_print(-10);

  // expected-remark @+1 {{-5}}
  @comptime_print(-10 + 5);

  // expected-remark @+1 {{-20}}
  @comptime_print(-4 * 5);

  // expected-remark @+1 {{-3}}
  @comptime_print(-15 / 5);
}

// -----

// =============================================================================
// Typed signed integer arithmetic (i32)
// =============================================================================

comptime {
  const a: i32 = 42;
  const b: i32 = 10;

  // expected-remark @+1 {{52}}
  @comptime_print(a + b);
  // expected-remark @+1 {{i32}}
  @comptime_print(@type_of(a + b));

  // expected-remark @+1 {{32}}
  @comptime_print(a - b);
  // expected-remark @+1 {{i32}}
  @comptime_print(@type_of(a - b));

  // expected-remark @+1 {{420}}
  @comptime_print(a * b);
  // expected-remark @+1 {{i32}}
  @comptime_print(@type_of(a * b));

  // expected-remark @+1 {{4}}
  @comptime_print(a / b);
  // expected-remark @+1 {{i32}}
  @comptime_print(@type_of(a / b));

  // expected-remark @+1 {{2}}
  @comptime_print(a % b);
  // expected-remark @+1 {{i32}}
  @comptime_print(@type_of(a % b));
}

// -----

// =============================================================================
// Typed signed integer arithmetic (i8)
// =============================================================================

comptime {
  const a: i8 = 100;
  const b: i8 = 10;

  // expected-remark @+1 {{110}}
  @comptime_print(a + b);
  // expected-remark @+1 {{i8}}
  @comptime_print(@type_of(a + b));

  // expected-remark @+1 {{90}}
  @comptime_print(a - b);
  // expected-remark @+1 {{10}}
  @comptime_print(a / b);
  // expected-remark @+1 {{0}}
  @comptime_print(a % b);
  // expected-remark @+1 {{i8}}
  @comptime_print(@type_of(a % b));
}

// -----

// =============================================================================
// Typed signed integer arithmetic (i16)
// =============================================================================

comptime {
  const a: i16 = 1000;
  const b: i16 = 500;

  // expected-remark @+1 {{1500}}
  @comptime_print(a + b);
  // expected-remark @+1 {{i16}}
  @comptime_print(@type_of(a + b));

  // expected-remark @+1 {{500}}
  @comptime_print(a - b);
  // expected-remark @+1 {{2}}
  @comptime_print(a / b);
  // expected-remark @+1 {{0}}
  @comptime_print(a % b);
}

// -----

// =============================================================================
// Typed unsigned integer arithmetic (u32)
// =============================================================================

comptime {
  const a: u32 = 42;
  const b: u32 = 10;

  // expected-remark @+1 {{52}}
  @comptime_print(a + b);
  // expected-remark @+1 {{u32}}
  @comptime_print(@type_of(a + b));

  // expected-remark @+1 {{32}}
  @comptime_print(a - b);
  // expected-remark @+1 {{420}}
  @comptime_print(a * b);
  // expected-remark @+1 {{4}}
  @comptime_print(a / b);
  // expected-remark @+1 {{2}}
  @comptime_print(a % b);
  // expected-remark @+1 {{u32}}
  @comptime_print(@type_of(a % b));
}

// -----

// =============================================================================
// Typed unsigned integer arithmetic (u8)
// =============================================================================

comptime {
  const a: u8 = 200;
  const b: u8 = 50;

  // expected-remark @+1 {{250}}
  @comptime_print(a + b);
  // expected-remark @+1 {{u8}}
  @comptime_print(@type_of(a + b));

  // expected-remark @+1 {{150}}
  @comptime_print(a - b);
  // expected-remark @+1 {{4}}
  @comptime_print(a / b);
  // expected-remark @+1 {{0}}
  @comptime_print(a % b);
}

// -----

// =============================================================================
// Typed integer comparisons (i32) - result type is bool
// =============================================================================

comptime {
  const a: i32 = 42;
  const b: i32 = 10;

  // expected-remark @+1 {{false}}
  @comptime_print(a == b);
  // expected-remark @+1 {{bool}}
  @comptime_print(@type_of(a == b));

  // expected-remark @+1 {{true}}
  @comptime_print(a == a);
  // expected-remark @+1 {{true}}
  @comptime_print(a != b);
  // expected-remark @+1 {{bool}}
  @comptime_print(@type_of(a != b));

  // expected-remark @+1 {{false}}
  @comptime_print(a < b);
  // expected-remark @+1 {{true}}
  @comptime_print(b < a);
  // expected-remark @+1 {{true}}
  @comptime_print(a > b);
  // expected-remark @+1 {{bool}}
  @comptime_print(@type_of(a > b));

  // expected-remark @+1 {{true}}
  @comptime_print(a >= a);
  // expected-remark @+1 {{true}}
  @comptime_print(b <= a);
}

// -----

// =============================================================================
// Typed unsigned integer comparisons (u8)
// =============================================================================

comptime {
  const a: u8 = 255;
  const b: u8 = 1;

  // expected-remark @+1 {{false}}
  @comptime_print(a < b);
  // expected-remark @+1 {{bool}}
  @comptime_print(@type_of(a < b));

  // expected-remark @+1 {{true}}
  @comptime_print(a > b);
  // expected-remark @+1 {{true}}
  @comptime_print(b < a);
}

// -----

// =============================================================================
// Typed integer negative values
// =============================================================================

comptime {
  const a: i32 = -42;
  const b: i32 = 6;

  // expected-remark @+1 {{-7}}
  @comptime_print(a / b);
  // expected-remark @+1 {{-36}}
  @comptime_print(a + b);
  // expected-remark @+1 {{-48}}
  @comptime_print(a - b);
  // expected-remark @+1 {{-252}}
  @comptime_print(a * b);
  // expected-remark @+1 {{i32}}
  @comptime_print(@type_of(a * b));
}

// -----

// =============================================================================
// Typed integer bitwise operations (u32)
// =============================================================================

comptime {
  const a: u32 = 0xFF;
  const b: u32 = 0x0F;

  // expected-remark @+1 {{15}}
  @comptime_print(a & b);
  // expected-remark @+1 {{u32}}
  @comptime_print(@type_of(a & b));

  // expected-remark @+1 {{255}}
  @comptime_print(a | b);
  // expected-remark @+1 {{u32}}
  @comptime_print(@type_of(a | b));

  // expected-remark @+1 {{240}}
  @comptime_print(a ^ b);
  // expected-remark @+1 {{u32}}
  @comptime_print(@type_of(a ^ b));
}

// -----

// =============================================================================
// Typed integer shift operations (u32)
// =============================================================================

comptime {
  const a: u32 = 1;

  // expected-remark @+1 {{2}}
  @comptime_print(a << 1);
  // expected-remark @+1 {{u32}}
  @comptime_print(@type_of(a << 1));

  // expected-remark @+1 {{4}}
  @comptime_print(a << 2);
  // expected-remark @+1 {{128}}
  @comptime_print(a << 7);

  const b: u32 = 128;
  // expected-remark @+1 {{1}}
  @comptime_print(b >> 7);
  // expected-remark @+1 {{u32}}
  @comptime_print(@type_of(b >> 7));

  // expected-remark @+1 {{32}}
  @comptime_print(b >> 2);
}

// -----

// =============================================================================
// Float arithmetic (f32)
// =============================================================================

comptime {
  const a: f32 = 3.0;
  const b: f32 = 4.0;

  // expected-remark @+1 {{7}}
  @comptime_print(a + b);
  // expected-remark @+1 {{f32}}
  @comptime_print(@type_of(a + b));

  // expected-remark @+1 {{-1}}
  @comptime_print(a - b);
  // expected-remark @+1 {{f32}}
  @comptime_print(@type_of(a - b));

  // expected-remark @+1 {{12}}
  @comptime_print(a * b);
  // expected-remark @+1 {{0.75}}
  @comptime_print(a / b);
  // expected-remark @+1 {{f32}}
  @comptime_print(@type_of(a / b));
}

// -----

// =============================================================================
// Float comparisons (f32)
// =============================================================================

comptime {
  const a: f32 = 3.14;
  const b: f32 = 2.71;

  // expected-remark @+1 {{true}}
  @comptime_print(a == a);
  // expected-remark @+1 {{bool}}
  @comptime_print(@type_of(a == a));

  // expected-remark @+1 {{false}}
  @comptime_print(a == b);
  // expected-remark @+1 {{true}}
  @comptime_print(a != b);
  // expected-remark @+1 {{true}}
  @comptime_print(b < a);
  // expected-remark @+1 {{bool}}
  @comptime_print(@type_of(b < a));

  // expected-remark @+1 {{false}}
  @comptime_print(a < b);
  // expected-remark @+1 {{true}}
  @comptime_print(a > b);
  // expected-remark @+1 {{true}}
  @comptime_print(a >= a);
  // expected-remark @+1 {{true}}
  @comptime_print(b <= a);
  // expected-remark @+1 {{true}}
  @comptime_print(b <= b);
}

// -----

// =============================================================================
// Comptime float arithmetic
// =============================================================================

comptime {
  // expected-remark @+1 {{6}}
  @comptime_print(3.0 + 3.0);
  // expected-remark @+1 {{comptime_float}}
  @comptime_print(@type_of(3.0 + 3.0));

  // expected-remark @+1 {{6}}
  @comptime_print(10.5 - 4.5);
  // expected-remark @+1 {{12}}
  @comptime_print(3.0 * 4.0);
  // expected-remark @+1 {{5}}
  @comptime_print(10.0 / 2.0);
  // expected-remark @+1 {{0.5}}
  @comptime_print(1.0 / 2.0);
}

// -----

// =============================================================================
// Comptime float comparisons
// =============================================================================

comptime {
  // expected-remark @+1 {{true}}
  @comptime_print(3.14 == 3.14);
  // expected-remark @+1 {{bool}}
  @comptime_print(@type_of(3.14 == 3.14));

  // expected-remark @+1 {{false}}
  @comptime_print(3.14 == 2.71);
  // expected-remark @+1 {{true}}
  @comptime_print(3.14 != 2.71);
  // expected-remark @+1 {{true}}
  @comptime_print(2.71 < 3.14);
  // expected-remark @+1 {{false}}
  @comptime_print(3.14 < 2.71);
  // expected-remark @+1 {{true}}
  @comptime_print(3.14 > 2.71);
  // expected-remark @+1 {{true}}
  @comptime_print(3.14 >= 3.14);
  // expected-remark @+1 {{false}}
  @comptime_print(2.71 >= 3.14);
  // expected-remark @+1 {{true}}
  @comptime_print(2.71 <= 3.14);
  // expected-remark @+1 {{true}}
  @comptime_print(3.14 <= 3.14);
}

// -----

// =============================================================================
// Near-overflow cases that succeed
// =============================================================================

comptime {
  const near_max: i32 = 2147483646;
  // expected-remark @+1 {{2147483647}}
  @comptime_print(near_max + 1);
  // expected-remark @+1 {{i32}}
  @comptime_print(@type_of(near_max + 1));

  const near_min: i32 = -2147483647;
  // expected-remark @+1 {{-2147483648}}
  @comptime_print(near_min - 1);

  const max_u8: u8 = 254;
  // expected-remark @+1 {{255}}
  @comptime_print(max_u8 + 1);
  // expected-remark @+1 {{u8}}
  @comptime_print(@type_of(max_u8 + 1));

  const max_i8: i8 = 126;
  // expected-remark @+1 {{127}}
  @comptime_print(max_i8 + 1);
  // expected-remark @+1 {{i8}}
  @comptime_print(@type_of(max_i8 + 1));
}

// -----

// =============================================================================
// Error: division by zero (comptime_int)
// =============================================================================

comptime {
  // expected-error @+1 {{division by zero}}
  const x = 10 / 0;
}

// -----

// =============================================================================
// Error: modulo by zero (comptime_int)
// =============================================================================

comptime {
  // expected-error @+1 {{modulo by zero}}
  const x = 10 % 0;
}

// -----

// =============================================================================
// Error: i32 addition overflow
// =============================================================================

comptime {
  const max_i32: i32 = 2147483647;
  // expected-error @+1 {{addition overflow}}
  const overflow = max_i32 + 1;
}

// -----

// =============================================================================
// Error: i32 multiplication overflow
// =============================================================================

comptime {
  const large: i32 = 1000000;
  // expected-error @+1 {{multiplication overflow}}
  const overflow = large * large;
}

// -----

// =============================================================================
// Error: i32 subtraction underflow
// =============================================================================

comptime {
  const min_i32: i32 = -2147483648;
  // expected-error @+1 {{subtraction overflow}}
  const underflow = min_i32 - 1;
}

// -----

// =============================================================================
// Error: i8 addition overflow
// =============================================================================

comptime {
  const max_i8: i8 = 127;
  // expected-error @+1 {{addition overflow}}
  const overflow = max_i8 + 1;
}

// -----

// =============================================================================
// Error: i8 subtraction underflow
// =============================================================================

comptime {
  const min_i8: i8 = -128;
  // expected-error @+1 {{subtraction overflow}}
  const underflow = min_i8 - 1;
}

// -----

// =============================================================================
// Error: i16 addition overflow
// =============================================================================

comptime {
  const max_i16: i16 = 32767;
  // expected-error @+1 {{addition overflow}}
  const overflow = max_i16 + 1;
}

// -----

// =============================================================================
// Error: u8 addition overflow
// =============================================================================

comptime {
  const max_u8: u8 = 255;
  // expected-error @+1 {{addition overflow}}
  const overflow = max_u8 + 1;
}

// -----

// =============================================================================
// Error: shift amount exceeds bit width (u32)
// =============================================================================

comptime {
  const a: u32 = 1;
  // expected-error @+1 {{shift amount 32 exceeds bit width 32}}
  const overflow = a << 32;
}

// -----

// =============================================================================
// Error: left shift value overflow (i32)
// =============================================================================

comptime {
  const max_i32: i32 = 2147483647;
  // expected-error @+1 {{left shift overflow}}
  const overflow = max_i32 << 1;
}

// -----

// =============================================================================
// Error: division by zero (typed i32)
// =============================================================================

comptime {
  const a: i32 = 42;
  const b: i32 = 0;
  // expected-error @+1 {{division by zero}}
  const result = a / b;
}

// -----

// =============================================================================
// Error: modulo by zero (typed u32)
// =============================================================================

comptime {
  const a: u32 = 42;
  const b: u32 = 0;
  // expected-error @+1 {{modulo by zero}}
  const result = a % b;
}

// -----

// =============================================================================
// Error: negation overflow (i32 MIN_INT)
// =============================================================================

comptime {
  const min_i32: i32 = -2147483648;
  // expected-error @+2 {{failed to evaluate unary operation during comptime}}
  // expected-remark @+1 {{negation overflow}}
  const overflow = -min_i32;
}

// -----

// =============================================================================
// Error: incompatible types - different integer widths
// =============================================================================

comptime {
  const a: i32 = 42;
  const b: i16 = 10;
  // expected-error @+1 {{incompatible types for binary operation: i32 and i16}}
  const result = a + b;
}

// -----

// =============================================================================
// Error: incompatible types - different integer signedness
// =============================================================================

comptime {
  const a: i32 = 42;
  const b: u32 = 10;
  // expected-error @+1 {{incompatible types for binary operation: i32 and u32}}
  const result = a + b;
}

// -----

// =============================================================================
// Error: incompatible types - float and integer
// =============================================================================

comptime {
  const a: f32 = 3.14;
  const b: i32 = 42;
  // expected-error @+1 {{incompatible types for binary operation: f32 and i32}}
  const result = a + b;
}

// -----

// =============================================================================
// Error: incompatible types - different float widths
// =============================================================================

comptime {
  const a: f32 = 3.14;
  const b: f16 = 2.0;
  // expected-error @+1 {{incompatible types for binary operation: f32 and f16}}
  const result = a + b;
}

// -----

// =============================================================================
// Error: incompatible types - comptime_int and float
// =============================================================================

comptime {
  const a: f32 = 3.14;
  // expected-error @+1 {{incompatible types for binary operation: comptime_int and f32}}
  const result = 42 + a;
}

// -----

// =============================================================================
// Error: incompatible types - comptime_float and integer
// =============================================================================

comptime {
  const a: i32 = 42;
  // expected-error @+1 {{incompatible types for binary operation: comptime_float and i32}}
  const result = 3.14 + a;
}

// -----

// =============================================================================
// Error: incompatible types - comparison between different types
// =============================================================================

comptime {
  const a: i32 = 42;
  const b: u32 = 10;
  // expected-error @+1 {{incompatible types for binary operation: i32 and u32}}
  const result = a < b;
}
