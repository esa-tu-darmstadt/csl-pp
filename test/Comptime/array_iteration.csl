// RUN: csl-s2s %s -verify-diagnostics --split-input-file

// =============================================================================
// Basic comptime array iteration (1D)
// =============================================================================

comptime {
  const arr = [3]i32{10, 20, 30};
  var sum: comptime_int = 0;
  for (arr) |elem| {
    sum = sum + elem;
  }
  // sum should be 10 + 20 + 30 = 60
  // expected-remark @+1 {{60}}
  @comptime_print(sum);
}

// -----

// =============================================================================
// Comptime array iteration with index
// =============================================================================

comptime {
  const arr = [3]i32{100, 200, 300};
  var elem_sum: comptime_int = 0;
  var idx_sum: comptime_int = 0;
  for (arr) |elem, idx| {
    elem_sum = elem_sum + elem;
    idx_sum = idx_sum + idx;
  }
  // elem_sum should be 100 + 200 + 300 = 600
  // idx_sum should be 0 + 1 + 2 = 3
  // expected-remark @+1 {{600}}
  @comptime_print(elem_sum);
  // expected-remark @+1 {{3}}
  @comptime_print(idx_sum);
}

// -----

// =============================================================================
// Comptime array iteration with break
// =============================================================================

comptime {
  const arr = [5]i32{1, 2, 3, 4, 5};
  var sum: comptime_int = 0;
  for (arr) |elem| {
    if (elem == 3) {
      break;
    }
    sum = sum + elem;
  }
  // sum should be 1 + 2 = 3 (break when elem == 3)
  // expected-remark @+1 {{3}}
  @comptime_print(sum);
}

// -----

// =============================================================================
// Comptime array iteration with continue
// =============================================================================

comptime {
  const arr = [5]i32{1, 2, 3, 4, 5};
  var sum: comptime_int = 0;
  for (arr) |elem| {
    if (elem == 3) {
      continue;
    }
    sum = sum + elem;
  }
  // sum should be 1 + 2 + 4 + 5 = 12 (skip elem == 3)
  // expected-remark @+1 {{12}}
  @comptime_print(sum);
}

// -----

// =============================================================================
// cslc has no for loops over multi-dimensional arrays
// =============================================================================

comptime {
  const arr = [2, 3]i32{1, 2, 3, 4, 5, 6};
  var sum: comptime_int = 0;
  // expected-error @+1 {{Cerebras' cslc compiler does not support for loops over multi-dimensional arrays such as '[2, 3]i32'; loop over the indices with @range instead}}
  for (arr) |elem| {
    sum = sum + elem;
  }
}

// -----

// =============================================================================
// Inline for loop syntax (backend hint, same semantics)
// =============================================================================

comptime {
  const arr = [3]i32{1, 2, 3};
  var sum: comptime_int = 0;
  inline for (arr) |elem| {
    sum = sum + elem;
  }
  // sum should be 1 + 2 + 3 = 6
  // expected-remark @+1 {{6}}
  @comptime_print(sum);
}

// -----

// =============================================================================
// Array iteration with @zeros
// =============================================================================

comptime {
  const arr = @zeros([4]i32);
  var sum: comptime_int = 0;
  for (arr) |elem| {
    sum = sum + elem;
  }
  // sum should be 0 (all zeros)
  // expected-remark @+1 {{0}}
  @comptime_print(sum);
}

// -----

// =============================================================================
// Array iteration with @constants
// =============================================================================

comptime {
  const arr = @constants([3]i32, 7);
  var sum: comptime_int = 0;
  for (arr) |elem| {
    sum = sum + elem;
  }
  // sum should be 7 + 7 + 7 = 21
  // expected-remark @+1 {{21}}
  @comptime_print(sum);
}

// -----

// =============================================================================
// Runtime array iteration (not unrolled, just type-checked)
// =============================================================================

var arr: [5]i32;

fn sum_array() i32 {
  var sum: i32 = 0;
  for (arr) |elem| {
    sum = sum + elem;
  }
  return sum;
}

comptime {
  @export_symbol(sum_array);
}

// -----

// =============================================================================
// Runtime array iteration with index
// =============================================================================

var arr: [4]i32;

fn weighted_sum() i32 {
  var sum: i32 = 0;
  for (arr) |elem, idx| {
    // Multiply element by index position
    sum = sum + elem * @as(i32, idx);
  }
  return sum;
}

comptime {
  @export_symbol(weighted_sum);
}

// -----

// =============================================================================
// Inline for loop on runtime array requires comptime-known iterable
// =============================================================================

fn inline_sum(arr: [3]i32) i32 {
  var sum: i32 = 0;
  // expected-error @+1 {{inline for loop iterable is not comptime-known}}
  inline for (arr) |elem| {
    sum = sum + elem;
  }
  return sum;
}

comptime {
  @export_symbol(inline_sum);
}
