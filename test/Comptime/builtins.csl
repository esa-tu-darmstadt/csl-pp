// RUN: csl-s2s %s -verify-diagnostics --split-input-file

// =============================================================================
// @comptime_print - variadic, MustEvaluate
// =============================================================================

comptime {
  // No arguments
  @comptime_print();

  // Single argument
  // expected-remark @+1 {{42}}
  @comptime_print(42);

  // Multiple arguments (each printed separately)
  // expected-remark @+3 {{1}}
  // expected-remark @+2 {{2}}
  // expected-remark @+1 {{3}}
  @comptime_print(1, 2, 3);

  // Type values
  // expected-remark @+2 {{i32}}
  // expected-remark @+1 {{f32}}
  @comptime_print(i32, f32);
}

// -----

// =============================================================================
// @type_of - returns the type of an expression
// =============================================================================

comptime {
  // Type of integer literal (comptime_int)
  // expected-remark @+1 {{comptime_int}}
  @comptime_print(@type_of(42));

  // Type of boolean literal
  // expected-remark @+1 {{bool}}
  @comptime_print(@type_of(true));

  // Type of string literal
  // expected-remark @+1 {{comptime_string}}
  @comptime_print(@type_of("hello"));

  // Type of typed variable
  const x: i32 = 10;
  // expected-remark @+1 {{i32}}
  @comptime_print(@type_of(x));

  // Type of float variable
  const y: f32 = 3.14;
  // expected-remark @+1 {{f32}}
  @comptime_print(@type_of(y));
}

// -----

// =============================================================================
// @is_same_type - type comparison
// =============================================================================

comptime {
  // Same types
  // expected-remark @+1 {{true}}
  @comptime_print(@is_same_type(i32, i32));

  // expected-remark @+1 {{true}}
  @comptime_print(@is_same_type(f32, f32));

  // Different types
  // expected-remark @+1 {{false}}
  @comptime_print(@is_same_type(i32, f32));

  // expected-remark @+1 {{false}}
  @comptime_print(@is_same_type(i32, i16));

  // Unsigned vs signed
  // expected-remark @+1 {{false}}
  @comptime_print(@is_same_type(i32, u32));
}

// -----

// =============================================================================
// @is_same_type with @type_of
// =============================================================================

comptime {
  const x: i32 = 10;
  const y: i32 = 20;
  const z: f32 = 3.14;

  // Same type variables
  // expected-remark @+1 {{true}}
  @comptime_print(@is_same_type(@type_of(x), @type_of(y)));

  // Different type variables
  // expected-remark @+1 {{false}}
  @comptime_print(@is_same_type(@type_of(x), @type_of(z)));

  // Compare with type literal
  // expected-remark @+1 {{true}}
  @comptime_print(@is_same_type(@type_of(x), i32));
}

// -----

// =============================================================================
// @comptime_assert - compile-time assertions
// =============================================================================

comptime {
  // Passing assertions (no output expected)
  @comptime_assert(true);
  @comptime_assert(1 == 1);
  @comptime_assert(10 > 5);

  // With message (still passing)
  @comptime_assert(true, "this should pass");
  @comptime_assert(2 + 2 == 4, "math works");
}

// -----

// =============================================================================
// @comptime_assert - failure case
// =============================================================================

comptime {
  // expected-error @+1 {{assertion failed}}
  @comptime_assert(false);
}

// -----

// =============================================================================
// @comptime_assert - failure with message
// =============================================================================

comptime {
  // expected-error @+1 {{custom error message}}
  @comptime_assert(false, "custom error message");
}

// -----

// =============================================================================
// @comptime_assert - failure with expression
// =============================================================================

comptime {
  const x = 5;
  const y = 10;
  // expected-error @+1 {{x must be greater than y}}
  @comptime_assert(x > y, "x must be greater than y");
}

// -----

// =============================================================================
// Nested builtin calls
// =============================================================================

comptime {
  // @type_of inside @is_same_type
  const x: i32 = 42;
  // expected-remark @+1 {{true}}
  @comptime_print(@is_same_type(@type_of(x), i32));

  // Multiple nested calls
  // expected-remark @+1 {{true}}
  @comptime_print(@is_same_type(@type_of(42 + 1), comptime_int));
}

// -----

// =============================================================================
// Type introspection patterns
// =============================================================================

fn check_type(comptime T: type) bool {
  return @is_same_type(T, i32) or @is_same_type(T, i16);
}

comptime {
  // expected-remark @+1 {{true}}
  @comptime_print(check_type(i32));

  // expected-remark @+1 {{true}}
  @comptime_print(check_type(i16));

  // expected-remark @+1 {{false}}
  @comptime_print(check_type(f32));
}

// -----

// =============================================================================
// @is_same_type signature validation - requires exactly 2 type arguments
// =============================================================================

comptime {
  // expected-error @+1 {{no matching signature for @is_same_type}}
  @is_same_type(i32);
}

// -----

// =============================================================================
// @is_same_type with non-type arguments
// =============================================================================

comptime {
  // expected-error @+1 {{no matching signature for @is_same_type}}
  @is_same_type(42, 42);
}

// -----

// =============================================================================
// Using type results
// =============================================================================

comptime {
  const T = @type_of(42);
  // expected-remark @+1 {{comptime_int}}
  @comptime_print(T);

  // Use in @is_same_type
  // expected-remark @+1 {{true}}
  @comptime_print(@is_same_type(T, comptime_int));
}

// -----

// =============================================================================
// @range and @range_start/@range_stop/@range_step - range builtins
// =============================================================================

comptime {
  // Full form: @range(type, start, stop, step)
  const r1 = @range(i32, 0, 10, 1);
  // expected-remark @+1 {{0}}
  @comptime_print(@range_start(r1));
  // expected-remark @+1 {{10}}
  @comptime_print(@range_stop(r1));
  // expected-remark @+1 {{1}}
  @comptime_print(@range_step(r1));

  // Short form: @range(type, stop) - implicit start=0, step=1
  const r2 = @range(u16, 100);
  // expected-remark @+1 {{0}}
  @comptime_print(@range_start(r2));
  // expected-remark @+1 {{100}}
  @comptime_print(@range_stop(r2));
  // expected-remark @+1 {{1}}
  @comptime_print(@range_step(r2));

  // Custom step
  const r3 = @range(i16, 5, 50, 5);
  // expected-remark @+1 {{5}}
  @comptime_print(@range_start(r3));
  // expected-remark @+1 {{50}}
  @comptime_print(@range_stop(r3));
  // expected-remark @+1 {{5}}
  @comptime_print(@range_step(r3));

  // Negative step (count down)
  const r4 = @range(i32, 10, 0, -1);
  // expected-remark @+1 {{10}}
  @comptime_print(@range_start(r4));
  // expected-remark @+1 {{0}}
  @comptime_print(@range_stop(r4));
  // expected-remark @+1 {{-1}}
  @comptime_print(@range_step(r4));
}

// -----

// =============================================================================
// @range - print entire range value
// =============================================================================

comptime {
  const r = @range(i32, 1, 10, 2);
  // expected-remark @+1 {{@range(i32, 1, 10, 2)}}
  @comptime_print(r);
}

// -----

// =============================================================================
// @range - type introspection
// =============================================================================

comptime {
  const r = @range(u32, 0, 100, 1);
  // expected-remark @+1 {{range<u32>}}
  @comptime_print(@type_of(r));
}

// -----

// =============================================================================
// @is_arch - architecture detection (default is wse2)
// =============================================================================

comptime {
  // Default architecture is wse2
  // expected-remark @+1 {{true}}
  @comptime_print(@is_arch("wse2"));

  // wse3 should be false with default arch
  // expected-remark @+1 {{false}}
  @comptime_print(@is_arch("wse3"));

  // Unknown architecture should be false
  // expected-remark @+1 {{false}}
  @comptime_print(@is_arch("unknown"));
}

// -----

// =============================================================================
// @is_arch - signature validation
// =============================================================================

comptime {
  // expected-error @+1 {{no matching signature for @is_arch}}
  @is_arch(42);
}

// -----

// =============================================================================
// @is_arch - requires exactly 1 argument
// =============================================================================

comptime {
  // expected-error @+1 {{no matching signature for @is_arch}}
  @is_arch();
}

// -----

// =============================================================================
// @is_arch - used inside function branches (default is wse2)
// =============================================================================

fn get_arch_value() i32 {
  if (@is_arch("wse2")) {
    return 2;
  }
  if (@is_arch("wse3")) {
    return 3;
  }
  return 0;
}

comptime {
  // With default arch (wse2), should return 2
  // expected-remark @+1 {{2}}
  @comptime_print(get_arch_value());
}

// -----

// =============================================================================
// @strlen - returns length of compile-time string
// =============================================================================

comptime {
  // Empty string
  // expected-remark @+1 {{0}}
  @comptime_print(@strlen(""));

  // Regular string
  // expected-remark @+1 {{6}}
  @comptime_print(@strlen("abc123"));

  // String with spaces
  // expected-remark @+1 {{12}}
  @comptime_print(@strlen("hello world!"));

  // Using in expressions
  const len = @strlen("test");
  // expected-remark @+1 {{4}}
  @comptime_print(len);
}

// -----

// =============================================================================
// @strlen - conditional string
// =============================================================================

comptime {
  // Conditional selection of string
  // expected-remark @+1 {{3}}
  @comptime_print(@strlen(if (42 == 42) "abc" else "abc123"));

  // expected-remark @+1 {{6}}
  @comptime_print(@strlen(if (42 != 42) "abc" else "abc123"));
}

// -----

// =============================================================================
// @strlen - signature validation
// =============================================================================

comptime {
  // expected-error @+1 {{no matching signature for @strlen}}
  @strlen(42);
}

// -----

// =============================================================================
// @strlen - requires exactly 1 argument
// =============================================================================

comptime {
  // expected-error @+1 {{no matching signature for @strlen}}
  @strlen();
}

// -----

// =============================================================================
// @strcat - concatenates compile-time strings
// =============================================================================

comptime {
  // No arguments - returns empty string
  // expected-remark @+1 {{""}}
  @comptime_print(@strcat());

  // Single argument
  // expected-remark @+1 {{"abc"}}
  @comptime_print(@strcat("abc"));

  // Two arguments
  // expected-remark @+1 {{"abc123"}}
  @comptime_print(@strcat("abc", "123"));

  // Multiple arguments
  // expected-remark @+1 {{"hello world!"}}
  @comptime_print(@strcat("hello", " ", "world!"));

  // Empty strings in mix
  // expected-remark @+1 {{"foobar"}}
  @comptime_print(@strcat("foo", "", "bar"));
}

// -----

// =============================================================================
// @strcat - with @strlen
// =============================================================================

comptime {
  // Length of concatenated string
  // expected-remark @+1 {{6}}
  @comptime_print(@strlen(@strcat("foo", "bar")));

  // Store result and use
  const s = @strcat("hello", " ", "world");
  // expected-remark @+1 {{11}}
  @comptime_print(@strlen(s));
}

// -----

// =============================================================================
// @strcat - signature validation (all args must be comptime_string)
// =============================================================================

comptime {
  // expected-error @+1 {{no matching signature for @strcat}}
  @strcat("hello", 42);
}

// -----

// =============================================================================
// @export_symbol - builtin for exporting symbols (Smoke Test)
// =============================================================================

fn func1() void {
  return;
}

const someConst : u32 = 1234;
var someVar : f32 = 3.14;

const mod = @import_module("Modules/simple_module.csl.module");

comptime {
  @export_symbol(func1);
  @export_symbol(someConst);
  @export_symbol(someVar);
  @export_symbol(mod.module_add);
  @export_symbol(mod.module_add);
  @export_symbol(mod.module_inner_call);
  @export_symbol(mod.module_var);
  @export_symbol(mod.MODULE_CONST);
}

// -----

// =============================================================================
// Unknown builtins in dead code should not cause errors
// =============================================================================

export fn unknown_builtin_dead_code() void {
    if (false) {
        @nonexistent_builtin(42);
    }
}

// -----

// =============================================================================
// Unknown builtins in reachable code should cause errors
// =============================================================================

export fn unknown_builtin_reachable() void {
    // expected-error @+1 {{unknown builtin function: @nonexistent_builtin}}
    @nonexistent_builtin(42);
}

// -----

// =============================================================================
// @set_rectangle makes @get_rectangle available during comptime
// =============================================================================

comptime {
  @set_rectangle(4, 3);
  const rect = @get_rectangle();

  // expected-remark @+1 {{4}}
  @comptime_print(rect.width);
  // expected-remark @+1 {{3}}
  @comptime_print(rect.height);
}

// -----

// =============================================================================
// @set_rectangle with typed comptime values
// =============================================================================

comptime {
  const w: u16 = 5;
  const h: u16 = 7;
  @set_rectangle(w, h);
  const rect = @get_rectangle();

  // expected-remark @+1 {{5}}
  @comptime_print(rect.width);
  // expected-remark @+1 {{7}}
  @comptime_print(rect.height);
}

// -----

// =============================================================================
// @set_rectangle with zero dimension should error
// =============================================================================

comptime {
  // expected-error @+1 {{@set_rectangle dimensions must be positive}}
  @set_rectangle(0, 3);
}

// -----

// =============================================================================
// @field - read and write struct fields by name
// =============================================================================

comptime {
  var my_struct = .{ .a = 10, .b = 20 };

  // Read field value
  // expected-remark @+1 {{10}}
  @comptime_print(@field(my_struct, "a"));
  // expected-remark @+1 {{20}}
  @comptime_print(@field(my_struct, "b"));

  // Write via @field returns lvalue
  @field(my_struct, "a") = 42;
  // expected-remark @+1 {{42}}
  @comptime_print(@field(my_struct, "a"));
  // expected-remark @+1 {{42}}
  @comptime_print(my_struct.a);

  // Read tuple fields by numeric string index (e.g. from an array of names).
  // This exercises the lvalue path: the tuple is stored in a variable, so
  // @field returns an lvalue that must be loaded via IndexAccess, not
  // FieldAccess.
  const anon_fields = [2]comptime_string { "0", "1" };
  var my_tuple = .{ @as(u16, 100), @as(u16, 200) };
  // expected-remark @+1 {{100}}
  @comptime_print(@field(my_tuple, anon_fields[0]));
  // expected-remark @+1 {{200}}
  @comptime_print(@field(my_tuple, anon_fields[1]));

  // Write tuple field via @field with numeric string index
  @field(my_tuple, "0") = @as(u16, 999);
  // expected-remark @+1 {{999}}
  @comptime_print(@field(my_tuple, "0"));
}