// RUN: csl-s2s %s -verify-diagnostics --split-input-file

// =============================================================================
// Basic generic function with comptime T: type
// =============================================================================

fn identity(comptime T: type, x: T) T {
  return x;
}

comptime {
  // expected-remark @+1 {{42}}
  @comptime_print(identity(i32, 42));
}

// -----

// =============================================================================
// Type introspection with @is_same_type
// =============================================================================

fn is_float(comptime T: type) bool {
  return @is_same_type(T, f16) or @is_same_type(T, f32);
}

comptime {
  // expected-remark @+1 {{true}}
  @comptime_print(is_float(f32));
  // expected-remark @+1 {{false}}
  @comptime_print(is_float(i32));
}

// -----

// =============================================================================
// Type-returning function based on comptime parameter
// =============================================================================

fn typeFunction(comptime arg0: i32) type {
  return if (arg0 == 10) i32 else f32;
}

comptime {
  const T1 = typeFunction(10);
  const T2 = typeFunction(20);
  // expected-remark @+1 {{i32}}
  @comptime_print(T1);
  // expected-remark @+1 {{f32}}
  @comptime_print(T2);
}

// -----

// =============================================================================
// Computing with types (bits_type pattern from docs)
// =============================================================================

fn bits_type(comptime T: type) type {
  return if (@is_same_type(T, f16)) u16
    else if (@is_same_type(T, f32)) u32
    else i32;
}

comptime {
  // expected-remark @+1 {{u16}}
  @comptime_print(bits_type(f16));
  // expected-remark @+1 {{u32}}
  @comptime_print(bits_type(f32));
}

// -----

// =============================================================================
// Multiple comptime parameters
// =============================================================================

fn make_array_type(comptime T: type, comptime N: i32) type {
  return [N]T;
}

comptime {
  const ArrayType = make_array_type(i32, 10);
  // expected-remark @+1 {{[10]i32}}
  @comptime_print(ArrayType);
}

// -----

// =============================================================================
// Chained type computations
// =============================================================================

fn is_signed(comptime T: type) bool {
  return @is_same_type(T, i8) or @is_same_type(T, i16)
    or @is_same_type(T, i32);
}

fn is_unsigned(comptime T: type) bool {
  return @is_same_type(T, u8) or @is_same_type(T, u16)
    or @is_same_type(T, u32);
}

fn is_integer(comptime T: type) bool {
  return is_signed(T) or is_unsigned(T);
}

comptime {
  // expected-remark @+1 {{true}}
  @comptime_print(is_integer(i32));
  // expected-remark @+1 {{true}}
  @comptime_print(is_integer(u16));
  // expected-remark @+1 {{false}}
  @comptime_print(is_integer(f32));
}

// -----

// =============================================================================
// Generic struct factory (Point pattern)
// =============================================================================

fn Point(comptime T: type) type {
  return struct {
    x: T,
    y: T,
  };
}

comptime {
  const p = Point(i32) { .x = 10, .y = 20 };
  // expected-remark @+1 {{30}}
  @comptime_print(p.x + p.y);
}

// -----

// =============================================================================
// Generic pair struct with two type parameters
// =============================================================================

fn pair(comptime T1: type, comptime T2: type) type {
  return struct {
    first: T1,
    second: T2,
  };
}

comptime {
  const my_pair = pair(i32, i32);
  const p = my_pair { .first = 100, .second = 200 };
  // expected-remark @+1 {{300}}
  @comptime_print(p.first + p.second);
}

// -----

// =============================================================================
// Nested generic structs
// =============================================================================

fn Wrapper(comptime T: type) type {
  return struct {
    inner: T,
    count: i32,
  };
}

fn Point2(comptime T: type) type {
  return struct {
    x: T,
    y: T,
  };
}

comptime {
  const wrapped = Wrapper(Point2(i32));
  const w = wrapped {
    .inner = Point2(i32) { .x = 5, .y = 10 },
    .count = 1
  };
  // expected-remark @+1 {{15}}
  @comptime_print(w.inner.x + w.inner.y);
}

// -----

// =============================================================================
// Dependent parameter types using @type_of in function signature
// =============================================================================

// Convert signed to unsigned type
fn to_unsigned(comptime T: type) type {
  return if (@is_same_type(T, i8)) u8
    else if (@is_same_type(T, i16)) u16
    else if (@is_same_type(T, i32)) u32
    else T;  // Return unchanged for non-signed types
}

// Function where second param type depends on first param's type
fn add_as_unsigned(arg0: anytype, arg1: to_unsigned(@type_of(arg0))) to_unsigned(@type_of(arg0)) {
  return @as(to_unsigned(@type_of(arg0)), arg0) + arg1;
}

comptime {
  // i16 -> u16: add_as_unsigned(i16, u16) -> u16
  const result: u16 = add_as_unsigned(@as(i16, 10), @as(u16, 20));
  // expected-remark @+1 {{30}}
  @comptime_print(result);
}

// -----

// =============================================================================
// Dependent parameter with type-computing function
// =============================================================================

fn double_width(comptime T: type) type {
  return if (@is_same_type(T, i8)) i16
    else if (@is_same_type(T, i16)) i32
    else if (@is_same_type(T, u8)) u16
    else if (@is_same_type(T, u16)) u32
    else T;
}

// Function where param and return types depend on first arg's type
fn widen_add(a: anytype, b: double_width(@type_of(a))) double_width(@type_of(a)) {
  return @as(double_width(@type_of(a)), a) + b;
}

comptime {
  // Verify double_width type computation
  // expected-remark @+1 {{i16}}
  @comptime_print(double_width(i8));
  // expected-remark @+1 {{i32}}
  @comptime_print(double_width(i16));
  // expected-remark @+1 {{u16}}
  @comptime_print(double_width(u8));
  // expected-remark @+1 {{u32}}
  @comptime_print(double_width(u16));
}

// -----

// =============================================================================
// Verify function signature with dependent types
// =============================================================================

fn widen_type(comptime T: type) type {
  return if (@is_same_type(T, i8)) i16
    else if (@is_same_type(T, i16)) i32
    else T;
}

fn widen_and_add(a: anytype, b: widen_type(@type_of(a))) widen_type(@type_of(a)) {
  return @as(widen_type(@type_of(a)), a) + b;
}

comptime {
  // i8 widens to i16: widen_and_add(i8, i16) -> i16
  const r1: i16 = widen_and_add(@as(i8, 5), @as(i16, 10));
  // expected-remark @+1 {{15}}
  @comptime_print(r1);

  // i16 widens to i32: widen_and_add(i16, i32) -> i32
  const r2: i32 = widen_and_add(@as(i16, 100), @as(i32, 200));
  // expected-remark @+1 {{300}}
  @comptime_print(r2);
}

// -----

// =============================================================================
// Error case with @comptime_assert in generic function
// =============================================================================

// expected-remark @+1 {{comptime call to this function failed}}
fn must_be_positive(comptime N: i32) i32 {
  // expected-error @+1 {{N must be positive}}
  @comptime_assert(N > 0, "N must be positive");
  return N;
}

comptime {
  const x = must_be_positive(-5);
}
