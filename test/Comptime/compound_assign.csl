// RUN: csl-s2s %s -verify-diagnostics --split-input-file

// =============================================================================
// Compound assignment operators
// =============================================================================

comptime {
    var x: i32 = 10;

    x += 5;
    // expected-remark @+1 {{15}}
    @comptime_print(x);

    x -= 3;
    // expected-remark @+1 {{12}}
    @comptime_print(x);

    x *= 2;
    // expected-remark @+1 {{24}}
    @comptime_print(x);

    x /= 4;
    // expected-remark @+1 {{6}}
    @comptime_print(x);

    x %= 4;
    // expected-remark @+1 {{2}}
    @comptime_print(x);
}

// -----

// =============================================================================
// Shift compound assignments
// =============================================================================

comptime {
    var x: i32 = 8;

    x <<= 2;
    // expected-remark @+1 {{32}}
    @comptime_print(x);

    x >>= 3;
    // expected-remark @+1 {{4}}
    @comptime_print(x);
}

// -----

// =============================================================================
// Bitwise compound assignments
// =============================================================================

comptime {
    var x: i32 = 0b1010;

    x &= 0b1100;
    // expected-remark @+1 {{8}}
    @comptime_print(x);

    x |= 0b0011;
    // expected-remark @+1 {{11}}
    @comptime_print(x);

    x ^= 0b0101;
    // expected-remark @+1 {{14}}
    @comptime_print(x);
}
