// A simple module for testing @import_module

const MODULE_CONST: i32 = 42;
var module_var: i32 = 100;

fn module_add(a: i32, b: i32) i32 {
  return a + b;
}

fn module_double(x: i32) i32 {
  return x * 2;
}

fn module_inner_call(x: i32) i32 {
  return module_add(x, MODULE_CONST);
}

fn generic_add(comptime T: type, a: T, b: T) T {
  return a + b;
}
