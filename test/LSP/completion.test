// RUN: sed "s|TEST_DIR|%/p|g" %s | csl-lsp-server -lit-test | FileCheck -strict-whitespace %s
// Test: identifier completion and dot completion on module members.
{"jsonrpc":"2.0","id":0,"method":"initialize","params":{"processId":123,"rootPath":"csl","capabilities":{},"trace":"off"}}
// -----
{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{
  "uri":"file://TEST_DIR/Inputs/main_completion.csl",
  "languageId":"csl",
  "version":1,
  "text":"const mod = @import_module(\"module_a.csl\");\n\nfn entry() void {\n    mod.\n}\n"
}}}
// -----
// Dot completion on "mod." — should list module members.
{"jsonrpc":"2.0","id":1,"method":"textDocument/completion","params":{
  "textDocument":{"uri":"file://TEST_DIR/Inputs/main_completion.csl"},
  "position":{"line":3,"character":8},
  "context":{"triggerKind":2,"triggerCharacter":"."}
}}
//      CHECK:  "id": 1,
// CHECK-NEXT:  "jsonrpc": "2.0",
// CHECK-NEXT:  "result": {
// CHECK:         "items": [
// CHECK:           "label": "my_const"
// CHECK:           "label": "my_var"
// CHECK:           "label": "add"
// -----
{"jsonrpc":"2.0","id":100,"method":"shutdown"}
// -----
{"jsonrpc":"2.0","method":"exit"}
