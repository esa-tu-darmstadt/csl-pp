---
// The pass pipeline of csl-pp: from CSL source through the two dialects to
// vanilla CSL. The bracket marks the part that the language server shares.
---

<figure class="passes" aria-label="The parser produces ParsedCSL; comptime evaluation, read resolution, module inlining and cast normalization refine it; a conversion produces TypedCSL; tail recursion to loops, async lowering, builtin and allocator lowering and layout loop rolling transform it; the emitter writes vanilla CSL for cslc. The parser and comptime evaluation are shared with the language server.">
  <svg viewBox="0 0 760 470" role="img">
    <defs>
      <marker id="parrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 0 L 10 5 L 0 10 z" class="arrowhead" />
      </marker>
    </defs>

    <!-- Left column: the flow -->
    <g class="box cslpp">
      <rect x="200" y="0" width="240" height="40" rx="8" />
      <text x="320" y="25" class="name">csl++ source</text>
    </g>
    <path class="arrow" d="M 320 40 V 58" />

    <g class="box stage">
      <rect x="200" y="60" width="240" height="40" rx="8" />
      <text x="320" y="85" class="name">Parser</text>
    </g>
    <path class="arrow" d="M 320 100 V 118" />

    <g class="dialect">
      <rect x="180" y="120" width="280" height="130" rx="10" />
      <text x="192" y="138" class="dialect-label">ParsedCSL: untyped, close to the source</text>
      <g class="box stage">
        <rect x="200" y="146" width="240" height="30" rx="6" />
        <text x="320" y="166" class="name">Comptime evaluation</text>
      </g>
      <g class="box stage">
        <rect x="200" y="180" width="240" height="30" rx="6" />
        <text x="320" y="200" class="name">Resolve reads, inline modules</text>
      </g>
      <g class="box stage">
        <rect x="200" y="214" width="240" height="30" rx="6" />
        <text x="320" y="234" class="name">Normalize casts</text>
      </g>
    </g>
    <path class="arrow" d="M 320 250 V 268" />

    <g class="dialect">
      <rect x="180" y="270" width="280" height="130" rx="10" />
      <text x="192" y="288" class="dialect-label">TypedCSL: statically typed, no comptime</text>
      <g class="box stage">
        <rect x="200" y="296" width="240" height="30" rx="6" />
        <text x="320" y="316" class="name">Async lowering</text>
      </g>
      <g class="box stage">
        <rect x="200" y="330" width="240" height="30" rx="6" />
        <text x="320" y="350" class="name">Claims and runtime builtins</text>
      </g>
      <g class="box stage">
        <rect x="200" y="364" width="240" height="30" rx="6" />
        <text x="320" y="384" class="name">Layout loop rolling, emission</text>
      </g>
    </g>
    <path class="arrow" d="M 320 400 V 418" />

    <g class="box csl">
      <rect x="200" y="420" width="240" height="40" rx="8" />
      <text x="320" y="445" class="name">Vanilla CSL for cslc</text>
    </g>

    <!-- Right side: the language server bracket -->
    <path class="bracket" d="M 470 62 H 484 V 176 H 470" />
    <text x="494" y="112" class="note">shared with the</text>
    <text x="494" y="128" class="note">language server</text>

    <!-- Left side: tile programs -->
    <path class="bracket" d="M 170 62 H 156 V 398 H 170" />
    <text x="146" y="214" class="note" text-anchor="end">once for the layout file,</text>
    <text x="146" y="230" class="note" text-anchor="end">once per distinct</text>
    <text x="146" y="246" class="note" text-anchor="end">PE program and</text>
    <text x="146" y="262" class="note" text-anchor="end">parameter set</text>
  </svg>
</figure>

<style>
  .passes {
    margin-block: 1.5rem 2rem;
    max-width: 46rem;
    margin-inline: auto;
  }
  .passes svg {
    display: block;
    width: 100%;
    height: auto;
    font-family: var(--sl-font-system);
  }
  .box rect {
    stroke-width: 1.5;
  }
  .box.cslpp rect {
    fill: var(--cpp-orange-bg);
    stroke: var(--cpp-orange);
  }
  .box.csl rect {
    fill: var(--cpp-teal-bg);
    stroke: var(--cpp-teal);
  }
  .box.stage rect {
    fill: var(--sl-color-gray-6);
    stroke: var(--sl-color-gray-4);
  }
  .box text {
    text-anchor: middle;
    fill: var(--sl-color-white);
  }
  .name {
    font-size: 14px;
    font-weight: 600;
  }
  .dialect rect {
    fill: none;
    stroke: var(--cpp-orange);
    stroke-width: 2;
  }
  .dialect-label {
    font-family: var(--sl-font-mono);
    font-size: 11.5px;
    font-weight: 600;
    fill: var(--cpp-orange);
  }
  .arrow {
    fill: none;
    stroke: var(--sl-color-gray-3);
    stroke-width: 2;
    marker-end: url(#parrow);
  }
  .arrowhead {
    fill: var(--sl-color-gray-3);
  }
  .bracket {
    fill: none;
    stroke: var(--sl-color-gray-3);
    stroke-width: 1.5;
  }
  .note {
    font-size: 12px;
    font-style: italic;
    fill: var(--sl-color-gray-2);
  }
</style>
