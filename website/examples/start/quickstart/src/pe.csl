// A first async task: doubles a vector with two asynchronous DSD
// operations in sequence, a copy and an addition.
param memcpy_params;
param N: i16;

const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);

const task_id: local_task_id = @claim_local_task();

var x = @zeros([N]f32);
var y = @zeros([N]f32);
var ptr_x: [*]f32 = &x;
const x_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{N} -> x[i] });
const y_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{N} -> y[i] });

// Operations between memory DSDs can only run asynchronously on explicit
// DSRs.
const dest_dsr = @get_dsr(dsr_dest, 1);
const src0_dsr = @get_dsr(dsr_src0, 1);
const src1_dsr = @get_dsr(dsr_src1, 1);

// region: task
async task double_task() void {
  // y = x; the operation activates this task when it completes.
  @load_to_dsr(dest_dsr, y_dsd);
  @load_to_dsr(src1_dsr, x_dsd);
  @mov32(dest_dsr, src1_dsr, .{ .async = true, .activate = @current_task() });
  suspend;
  // x = x + y
  @load_to_dsr(dest_dsr, x_dsd);
  @load_to_dsr(src0_dsr, x_dsd);
  @load_to_dsr(src1_dsr, y_dsd);
  @fadds(dest_dsr, src0_dsr, src1_dsr, .{ .async = true, .activate = @current_task() });
  suspend;
  sys_mod.unblock_cmd_stream();
}

// Called by the host.
fn compute() void {
  @coro_runtime_init();
  @activate(task_id);
}

comptime {
  @bind_local_task(double_task, task_id);
}
// endregion

comptime {
  @export_symbol(ptr_x, "x");
  @export_symbol(compute);
}
