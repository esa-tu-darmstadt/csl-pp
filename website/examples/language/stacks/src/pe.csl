param memcpy_params;

const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);

// region: recursion
// At most 16 calls of fib are active at the same time.
fn fib(n: u16) max_recursion_depth(16) u16 {
  if (n < 2) {
    return n;
  }
  return fib(n - 1) + fib(n - 2);
}
// endregion

// region: tail-call
// The recursive call is a tail call, so it is compiled into a loop.
fn gcd(a: u16, b: u16) u16 {
  if (b == 0) {
    return a;
  }
  return gcd(b, a % b);
}
// endregion

// region: stack-size
// Declares that wait_and_add and everything it calls need at most 128 bytes
// of stack, so csl-pp does not measure it.
async fn wait_and_add(a: u16, b: u16) stack_size(128) u16 {
  @activate(@current_task());
  suspend;
  return a + b;
}
// endregion

const main_task_id: local_task_id = @claim_local_task();

async task main_task() void {
  const sums = @await_parallel(wait_and_add(1, 2), wait_and_add(3, 4));
  @assert(sums[0] == 3);
  @assert(sums[1] == 7);
  @assert(fib(10) == 55);
  @assert(gcd(48, 18) == 6);
  sys_mod.unblock_cmd_stream();
}

// Called by the host.
fn compute() void {
  @coro_runtime_init();
  @activate(main_task_id);
}

comptime {
  @bind_local_task(main_task, main_task_id);
  @export_symbol(compute);
}
