param memcpy_params;

const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);

// region: comptime
// Claimed at compile time: these are constants in the generated CSL.
const first_color: color = @claim_color();
const second_color: color = @claim_color();
const done_task_id: local_task_id = @claim_local_task();

comptime {
  // Two claims never return the same resource.
  @comptime_assert(@get_int(first_color) != @get_int(second_color));
}
// endregion

// region: runtime
fn check_claims() void {
  // Claimed at runtime: never one of the colors claimed at compile time.
  const c = @claim_color();
  @assert(@get_int(c) != @get_int(first_color));
  @assert(@get_int(c) != @get_int(second_color));

  // A claim takes one of the free colors, and a release gives it back.
  const free = @count_free(color);
  const d = @claim_color();
  @assert(@count_free(color) == free - 1);
  @release_color(d);
  @assert(@count_free(color) == free);

  @release_color(c);
}
// endregion

// region: bind
task worker() void {
  @activate(done_task_id);
}

fn start_worker() void {
  // Claim a task ID and bind a task to it while the program runs.
  const id = @claim_local_task();
  @bind_local_task(worker, id);
  @activate(id);
}
// endregion

// The host waits for this task, which the worker activates.
task done() void {
  sys_mod.unblock_cmd_stream();
}

// Called by the host.
fn compute() void {
  check_claims();
  start_worker();
}

comptime {
  @bind_local_task(done, done_task_id);
  @export_symbol(compute);
}
