// stencil_3d_7pts: the "hybrid" implementation for WSE-3.
//
// Imported by ../pe.csl, which documents the interface. The exchange of
// the column with the neighbors is driven by three tasks that continue
// each other, as in the library of the Cerebras SDK: f_comm starts the
// exchange of a block by activating f_send and f_recv, f_send sends the
// block to one neighbor per activation, f_recv receives from one neighbor
// per activation, and when both have finished the block, f_comm continues
// with the next one. spmv() starts f_comm and suspends once; f_comm
// activates the task of spmv() after the last block.
//
// Compared with the "async" implementation, a product suspends once
// instead of once per transfer, but the three tasks take three local task
// IDs, which are claimed at compile time.
//
// The tasks continue each other through the completion of DSD
// operations: each send and each receive activates its own task when it
// completes (.activate = f_send or f_recv), and the task handles the next
// direction on that activation. send_state and recv_state record the
// direction; count_send_recv counts how many of the two have finished
// the block. The call graph of one product is
//
//   spmv -- @activate --> f_comm ----> f_send ----> laplacian_xy
//     ^                      |                  |
//     |                      +----> f_recv -----+
//     |                                  ...
//     +---- @activate (after the last block) ---+
//
// The DSDs of the exchange are set up once per product: mem_center_buf_dsd
// is bound to x and mem_y_buf_dsd to y, both are advanced by BLOCK_SIZE
// after each block, and update_dsd_length() sets the length of all DSDs
// of the exchange to the length of the block. With n = 3 and
// BLOCK_SIZE = 2, for example:
//   block 1: start = 0, length 2
//   block 2: start = 2, length 1 (the DSDs are shortened)
// The DSDs of the z part cover the whole column and are set up once.
//
// On WSE-3, each direction sends on an output queue of its own, the sends
// name the microthread output_ut_id, and the output queues are initialized
// with their colors.
//
// The sends and the receives use separate DSR sets (dsr_ids[0] and
// dsr_ids[1]), because they run at the same time. The stencil is applied
// afterwards and reuses the DSRs of the sends.

param c_recv_west: color;
param c_send_east: color;
param c_recv_east: color;
param c_send_west: color;

param c_recv_south: color;
param c_send_north: color;
param c_recv_north: color;
param c_send_south: color;

// Whether the PE is on the west, east, north or south edge of the
// rectangle, and therefore has no neighbor in that direction.
param first_px: bool;
param last_px: bool;
param first_py: bool;
param last_py: bool;

// The microthread of the sends.
param output_ut_id;

// Number of points exchanged with a neighbor at a time.
param BLOCK_SIZE: i16;

// Indices of the DSR sets of the sends and the receives.
param dsr_ids: [2]u16;

////////////////////////////////////////////////////////////////////////////////
// Tasks, queues, DSRs and DSDs
////////////////////////////////////////////////////////////////////////////////

const COMM: local_task_id = @claim_local_task(); // f_comm
const SEND: local_task_id = @claim_local_task(); // f_send
const RECV: local_task_id = @claim_local_task(); // f_recv

const iq_recv_west: input_queue = @claim_input_queue();
const iq_recv_east: input_queue = @claim_input_queue();
const iq_recv_south: input_queue = @claim_input_queue();
const iq_recv_north: input_queue = @claim_input_queue();

const oq_send_east: output_queue = @claim_output_queue();
const oq_send_west: output_queue = @claim_output_queue();
const oq_send_north: output_queue = @claim_output_queue();
const oq_send_south: output_queue = @claim_output_queue();

// The microthread must be known at compile time to configure the DSDs.
const out_ut: ut_id = @get_ut_id(output_ut_id);

const dest_dsr_send = @get_dsr(dsr_dest, dsr_ids[0]);
const src1_dsr_send = @get_dsr(dsr_src1, dsr_ids[0]);
const dest_dsr_recv = @get_dsr(dsr_dest, dsr_ids[1]);
const src1_dsr_recv = @get_dsr(dsr_src1, dsr_ids[1]);
const src0_dsr = @get_dsr(dsr_src0, dsr_ids[0]);

// The stencil coefficients of the running product:
//   y[i][j][k] = c_west   * x[i-1][j  ][k  ] + c_east  * x[i+1][j  ][k  ]
//              + c_south  * x[i  ][j-1][k  ] + c_north * x[i  ][j+1][k  ]
//              + c_bottom * x[i  ][j  ][k-1] + c_top   * x[i  ][j  ][k+1]
//              + c_center * x[i][j][k]
var c_west: f32;
var c_east: f32;
var c_south: f32;
var c_north: f32;
var c_bottom: f32;
var c_top: f32;
var c_center: f32;

// The blocks received from the four neighbors.
var west_buf = @zeros([BLOCK_SIZE]f32);
var east_buf = @zeros([BLOCK_SIZE]f32);
var south_buf = @zeros([BLOCK_SIZE]f32);
var north_buf = @zeros([BLOCK_SIZE]f32);

// The state of the exchange: how many of f_send and f_recv have finished
// the current block, and which direction each of them handles next.
var count_send_recv: i16 = 0;

const SEND_STATE_EAST: i16 = 0;
const SEND_STATE_WEST: i16 = 1;
const SEND_STATE_NORTH: i16 = 2;
const SEND_STATE_SOUTH: i16 = 3;
const SEND_STATE_DONE: i16 = 4;

const RECV_STATE_WEST: i16 = 0;
const RECV_STATE_EAST: i16 = 1;
const RECV_STATE_SOUTH: i16 = 2;
const RECV_STATE_NORTH: i16 = 3;
const RECV_STATE_DONE: i16 = 4;

var recv_state: i16 = RECV_STATE_WEST;
var send_state: i16 = SEND_STATE_EAST;

var zDim: i16 = 0;                   // length of the column, n
var cur_length: i16 = BLOCK_SIZE;    // length of the current block
var start_x: i16 = 0;                // start of the current block
var rem_length: i16 = 0;

// The task that waits in spmv(); f_comm activates it after the last block.
var awaiter_id: u16 = 0;

const dummy_f32 = @zeros([1]f32);

// The block of x that is sent, and the received blocks. spmv() binds
// mem_center_buf_dsd to x; f_comm advances it by BLOCK_SIZE after each
// block, and update_dsd_length() sets the length of all of them.
var mem_center_buf_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{BLOCK_SIZE} -> dummy_f32[i] });
var mem_west_buf_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{BLOCK_SIZE} -> west_buf[i] });
var mem_east_buf_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{BLOCK_SIZE} -> east_buf[i] });
var mem_south_buf_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{BLOCK_SIZE} -> south_buf[i] });
var mem_north_buf_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{BLOCK_SIZE} -> north_buf[i] });

// The block of y that accumulates the x-y part of the stencil; bound to y
// and advanced like mem_center_buf_dsd.
var mem_y_buf_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{BLOCK_SIZE} -> dummy_f32[i] });

// DSDs of the z part of the stencil, over the whole column, with the
// boundary condition x[-1] = x[zDim] = 0:
//   y[k] += x[k-1] * c_bottom   for k = 1 .. zDim-1
//   y[k] += x[k+1] * c_top      for k = 0 .. zDim-2
//   y[k] += x[k]   * c_center   for k = 0 .. zDim-1
// spmv() binds them to x and y and sets their lengths to zDim-1 or zDim.
var mem_y_z_minus_buf_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> dummy_f32[i+1] });
var mem_y_z_plus_buf_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> dummy_f32[i] });
var mem_y_z_buf_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> dummy_f32[i] });

var mem_x_z_minus_buf_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> dummy_f32[i] });
var mem_x_z_plus_buf_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> dummy_f32[i+1] });
var mem_x_z_buf_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> dummy_f32[i] });

var fab_recv_west_wdsd =  @get_dsd(fabin_dsd, .{
   .extent = BLOCK_SIZE,
   .fabric_color = c_recv_west,
   .input_queue = iq_recv_west
});

var fab_recv_east_wdsd =  @get_dsd(fabin_dsd, .{
   .extent = BLOCK_SIZE,
   .fabric_color = c_recv_east,
   .input_queue = iq_recv_east
});

var fab_recv_south_wdsd =  @get_dsd(fabin_dsd, .{
   .extent = BLOCK_SIZE,
   .fabric_color = c_recv_south,
   .input_queue = iq_recv_south
});

var fab_recv_north_wdsd =  @get_dsd(fabin_dsd, .{
   .extent = BLOCK_SIZE,
   .fabric_color = c_recv_north,
   .input_queue = iq_recv_north
});

var fab_trans_east_wdsd = @get_dsd(fabout_dsd, .{
    .extent = BLOCK_SIZE,
    .fabric_color = c_send_east,
    .output_queue = oq_send_east
});

var fab_trans_west_wdsd = @get_dsd(fabout_dsd, .{
    .extent = BLOCK_SIZE,
    .fabric_color = c_send_west,
    .output_queue = oq_send_west
});

var fab_trans_north_wdsd = @get_dsd(fabout_dsd, .{
    .extent = BLOCK_SIZE,
    .fabric_color = c_send_north,
    .output_queue = oq_send_north
});

var fab_trans_south_wdsd = @get_dsd(fabout_dsd, .{
    .extent = BLOCK_SIZE,
    .fabric_color = c_send_south,
    .output_queue = oq_send_south
});

////////////////////////////////////////////////////////////////////////////////
// The stencil
////////////////////////////////////////////////////////////////////////////////

// Adds the x-y part of the stencil for the current block to y, from the
// received blocks. The buffers of directions without a neighbor are zero.
fn laplacian_xy() void {
    @load_to_dsr(dest_dsr_send, mem_y_buf_dsd);
    @load_to_dsr(src0_dsr, mem_y_buf_dsd);
    @load_to_dsr(src1_dsr_send, mem_west_buf_dsd);
    @fmacs(dest_dsr_send, src0_dsr, src1_dsr_send, c_west);

    @load_to_dsr(dest_dsr_send, mem_y_buf_dsd);
    @load_to_dsr(src0_dsr, mem_y_buf_dsd);
    @load_to_dsr(src1_dsr_send, mem_east_buf_dsd);
    @fmacs(dest_dsr_send, src0_dsr, src1_dsr_send, c_east);

    @load_to_dsr(dest_dsr_send, mem_y_buf_dsd);
    @load_to_dsr(src0_dsr, mem_y_buf_dsd);
    @load_to_dsr(src1_dsr_send, mem_south_buf_dsd);
    @fmacs(dest_dsr_send, src0_dsr, src1_dsr_send, c_south);

    @load_to_dsr(dest_dsr_send, mem_y_buf_dsd);
    @load_to_dsr(src0_dsr, mem_y_buf_dsd);
    @load_to_dsr(src1_dsr_send, mem_north_buf_dsd);
    @fmacs(dest_dsr_send, src0_dsr, src1_dsr_send, c_north);
}

// Adds the z part of the stencil to y, over the whole column.
fn laplacian_z() void {
    // y[k] += x[k-1] * c_bottom for k = 1 .. zDim-1
    @load_to_dsr(dest_dsr_send, mem_y_z_minus_buf_dsd);
    @load_to_dsr(src0_dsr, mem_y_z_minus_buf_dsd);
    @load_to_dsr(src1_dsr_send, mem_x_z_minus_buf_dsd);
    @fmacs(dest_dsr_send, src0_dsr, src1_dsr_send, c_bottom);

    // y[k] += x[k+1] * c_top for k = 0 .. zDim-2
    @load_to_dsr(dest_dsr_send, mem_y_z_plus_buf_dsd);
    @load_to_dsr(src0_dsr, mem_y_z_plus_buf_dsd);
    @load_to_dsr(src1_dsr_send, mem_x_z_plus_buf_dsd);
    @fmacs(dest_dsr_send, src0_dsr, src1_dsr_send, c_top);

    // y[k] += x[k] * c_center for k = 0 .. zDim-1
    @load_to_dsr(dest_dsr_send, mem_y_z_buf_dsd);
    @load_to_dsr(src0_dsr, mem_y_z_buf_dsd);
    @load_to_dsr(src1_dsr_send, mem_x_z_buf_dsd);
    @fmacs(dest_dsr_send, src0_dsr, src1_dsr_send, c_center);
}

////////////////////////////////////////////////////////////////////////////////
// The exchange, as tasks
////////////////////////////////////////////////////////////////////////////////

// Called by f_send and f_recv when they have finished the current block.
// When both have, applies the x-y part of the stencil to the block and
// activates f_comm for the next one.
fn compute_and_next_send_recv() void {
    if (2 <= count_send_recv) {
        laplacian_xy();
        start_x += BLOCK_SIZE;
        mem_center_buf_dsd = @increment_dsd_offset(mem_center_buf_dsd, BLOCK_SIZE, f32);
        mem_y_buf_dsd = @increment_dsd_offset(mem_y_buf_dsd, BLOCK_SIZE, f32);
        @activate(COMM);
    }
}

// Sends the current block to one neighbor per activation, east, west,
// north, south. Each send activates f_send again when it completes; a
// direction without a neighbor activates it directly.
task f_send() void {
    if (SEND_STATE_EAST == send_state) {
        if (last_px) {
            @activate(SEND);
        } else {
            @load_to_dsr(dest_dsr_send, fab_trans_east_wdsd, .{.async=true, .activate = f_send, .ut_id = out_ut });
            @load_to_dsr(src1_dsr_send, mem_center_buf_dsd);
            @mov32(dest_dsr_send, src1_dsr_send, .{.async=true, .ut_id = out_ut} );
        }
        send_state = SEND_STATE_WEST;
    } else if (SEND_STATE_WEST == send_state) {
        if (first_px) {
            @activate(SEND);
        } else {
            @load_to_dsr(dest_dsr_send, fab_trans_west_wdsd, .{.async=true, .activate = f_send, .ut_id = out_ut });
            @load_to_dsr(src1_dsr_send, mem_center_buf_dsd);
            @mov32(dest_dsr_send, src1_dsr_send, .{.async=true, .ut_id = out_ut} );
        }
        send_state = SEND_STATE_NORTH;
    } else if (SEND_STATE_NORTH == send_state) {
        if (first_py) {
            @activate(SEND);
        } else {
            @load_to_dsr(dest_dsr_send, fab_trans_north_wdsd, .{.async=true, .activate = f_send, .ut_id = out_ut });
            @load_to_dsr(src1_dsr_send, mem_center_buf_dsd);
            @mov32(dest_dsr_send, src1_dsr_send, .{.async=true, .ut_id = out_ut} );
        }
        send_state = SEND_STATE_SOUTH;
    } else if (SEND_STATE_SOUTH == send_state) {
        if (last_py) {
            @activate(SEND);
        } else {
            @load_to_dsr(dest_dsr_send, fab_trans_south_wdsd, .{.async=true, .activate = f_send, .ut_id = out_ut });
            @load_to_dsr(src1_dsr_send, mem_center_buf_dsd);
            @mov32(dest_dsr_send, src1_dsr_send, .{.async=true, .ut_id = out_ut} );
        }
        send_state = SEND_STATE_DONE;
    } else {
        count_send_recv += 1;
        compute_and_next_send_recv();
        send_state = SEND_STATE_EAST;
    }
}

// Receives the current block from one neighbor per activation, west, east,
// south, north, into the buffer of that direction.
task f_recv() void {
    if (RECV_STATE_WEST == recv_state) {
        if (first_px) {
            @activate(RECV);
        } else {
            @load_to_dsr(dest_dsr_recv, mem_west_buf_dsd);
            @load_to_dsr(src1_dsr_recv, fab_recv_west_wdsd, .{.async=true, .activate = f_recv });
            @mov32(dest_dsr_recv, src1_dsr_recv, .{.async=true} );
        }
        recv_state = RECV_STATE_EAST;
    } else if (RECV_STATE_EAST == recv_state) {
        if (last_px) {
            @activate(RECV);
        } else {
            @load_to_dsr(dest_dsr_recv, mem_east_buf_dsd);
            @load_to_dsr(src1_dsr_recv, fab_recv_east_wdsd, .{.async=true, .activate = f_recv });
            @mov32(dest_dsr_recv, src1_dsr_recv, .{.async=true} );
        }
        recv_state = RECV_STATE_SOUTH;
    } else if (RECV_STATE_SOUTH == recv_state) {
        if (last_py) {
            @activate(RECV);
        } else {
            @load_to_dsr(dest_dsr_recv, mem_south_buf_dsd);
            @load_to_dsr(src1_dsr_recv, fab_recv_south_wdsd, .{.async=true, .activate = f_recv });
            @mov32(dest_dsr_recv, src1_dsr_recv, .{.async=true} );
        }
        recv_state = RECV_STATE_NORTH;
    } else if (RECV_STATE_NORTH == recv_state) {
        if (first_py) {
            @activate(RECV);
        } else {
            @load_to_dsr(dest_dsr_recv, mem_north_buf_dsd);
            @load_to_dsr(src1_dsr_recv, fab_recv_north_wdsd, .{.async=true, .activate = f_recv });
            @mov32(dest_dsr_recv, src1_dsr_recv, .{.async=true} );
        }
        recv_state = RECV_STATE_DONE;
    } else {
        count_send_recv += 1;
        compute_and_next_send_recv();
        recv_state = RECV_STATE_WEST;
    }
}

// Sets the length of the DSDs of the exchange and of the x-y part to the
// length of the current block.
fn update_dsd_length(cur_length: i16) void {
    var u16_cur_length: u16 = @bitcast(u16,cur_length);

    fab_recv_west_wdsd = @set_dsd_length(fab_recv_west_wdsd, u16_cur_length);
    fab_recv_east_wdsd = @set_dsd_length(fab_recv_east_wdsd, u16_cur_length);
    fab_recv_south_wdsd = @set_dsd_length(fab_recv_south_wdsd, u16_cur_length);
    fab_recv_north_wdsd = @set_dsd_length(fab_recv_north_wdsd, u16_cur_length);
    fab_trans_east_wdsd = @set_dsd_length(fab_trans_east_wdsd, u16_cur_length);
    fab_trans_west_wdsd = @set_dsd_length(fab_trans_west_wdsd, u16_cur_length);
    fab_trans_north_wdsd = @set_dsd_length(fab_trans_north_wdsd, u16_cur_length);
    fab_trans_south_wdsd = @set_dsd_length(fab_trans_south_wdsd, u16_cur_length);

    mem_center_buf_dsd = @set_dsd_length(mem_center_buf_dsd, u16_cur_length);
    mem_west_buf_dsd = @set_dsd_length(mem_west_buf_dsd, u16_cur_length);
    mem_east_buf_dsd = @set_dsd_length(mem_east_buf_dsd, u16_cur_length);
    mem_south_buf_dsd = @set_dsd_length(mem_south_buf_dsd, u16_cur_length);
    mem_north_buf_dsd = @set_dsd_length(mem_north_buf_dsd, u16_cur_length);

    mem_y_buf_dsd = @set_dsd_length(mem_y_buf_dsd, u16_cur_length);
}

// Starts the exchange of the next block, or, after the last block, adds
// the z part of the stencil and activates the task that waits in spmv().
task f_comm() void {
    rem_length = (zDim - start_x);
    if (0 < rem_length) {
        if (rem_length < cur_length) {
            cur_length = rem_length;
            update_dsd_length(cur_length);
        }

        @assert(RECV_STATE_WEST == recv_state);
        @assert(SEND_STATE_EAST == send_state);

        count_send_recv = 0;
        @activate(SEND);
        @activate(RECV);
    } else {
        laplacian_z();
        @activate(@get_local_task_id(awaiter_id));
    }
}

comptime {
    @bind_local_task(f_send, SEND);
    @bind_local_task(f_recv, RECV);
    @bind_local_task(f_comm, COMM);
}

////////////////////////////////////////////////////////////////////////////////
// The product
////////////////////////////////////////////////////////////////////////////////

// Computes y = A x for the local column x[0..n) with the coefficients
// coeff[0..7) in the order west, east, south, north, bottom, top, center.
// n must be at least 2, because the z part uses DSDs of length n-1.
//
// Sets up the DSDs, starts f_comm and suspends. f_comm activates this task
// again when the product is complete.
async fn spmv(n: i16, coeff: *[7]f32, x: [*]f32, y: [*]f32) void {
    @assert(2 <= n);

    awaiter_id = @get_int(@current_task());

    zDim = n;

    c_west = (coeff.*)[0];
    c_east = (coeff.*)[1];
    c_south = (coeff.*)[2];
    c_north = (coeff.*)[3];
    c_bottom = (coeff.*)[4];
    c_top = (coeff.*)[5];
    c_center = (coeff.*)[6];

    // The previous product may have ended with a shorter block, so the
    // lengths are reset for every product.
    cur_length = BLOCK_SIZE;
    if (zDim < cur_length) {
        cur_length = zDim;
    }
    mem_center_buf_dsd = @set_dsd_base_addr(mem_center_buf_dsd, x);
    mem_y_buf_dsd = @set_dsd_base_addr(mem_y_buf_dsd, y);
    update_dsd_length(cur_length);

    mem_y_z_minus_buf_dsd = @set_dsd_base_addr(mem_y_z_minus_buf_dsd, y);
    mem_y_z_minus_buf_dsd = @increment_dsd_offset(mem_y_z_minus_buf_dsd, 1, f32);
    mem_y_z_minus_buf_dsd = @set_dsd_length(mem_y_z_minus_buf_dsd, @bitcast(u16,zDim-1));

    mem_y_z_plus_buf_dsd = @set_dsd_base_addr(mem_y_z_plus_buf_dsd, y);
    mem_y_z_plus_buf_dsd = @set_dsd_length(mem_y_z_plus_buf_dsd, @bitcast(u16,zDim-1));

    mem_y_z_buf_dsd = @set_dsd_base_addr(mem_y_z_buf_dsd, y);
    mem_y_z_buf_dsd = @set_dsd_length(mem_y_z_buf_dsd, @bitcast(u16,zDim));

    mem_x_z_minus_buf_dsd = @set_dsd_base_addr(mem_x_z_minus_buf_dsd, x);
    mem_x_z_minus_buf_dsd = @set_dsd_length(mem_x_z_minus_buf_dsd, @bitcast(u16,zDim-1));

    mem_x_z_plus_buf_dsd = @set_dsd_base_addr(mem_x_z_plus_buf_dsd, x);
    mem_x_z_plus_buf_dsd = @increment_dsd_offset(mem_x_z_plus_buf_dsd, 1, f32);
    mem_x_z_plus_buf_dsd = @set_dsd_length(mem_x_z_plus_buf_dsd, @bitcast(u16,zDim-1));

    mem_x_z_buf_dsd = @set_dsd_base_addr(mem_x_z_buf_dsd, x);
    mem_x_z_buf_dsd = @set_dsd_length(mem_x_z_buf_dsd, @bitcast(u16,zDim));

    start_x = 0;

    // y = 0
    @load_to_dsr(dest_dsr_send, mem_y_z_buf_dsd);
    @fmovs(dest_dsr_send, @as(f32,0));

    @activate(COMM);
    suspend;
}

////////////////////////////////////////////////////////////////////////////////
// Routes and queues
////////////////////////////////////////////////////////////////////////////////

// Each color carries data in one direction between two neighbors; the
// layout part assigns the colors so that they alternate along a row or
// column. A PE on an edge of the rectangle configures only the colors of
// the neighbors it has.

// Eastward on C0 and C1: receive from the west, send to the east.
//
//         C0     C1     C0     C1     C0
// West P0 --> P1 --> P2 --> P3 --> P4 --> P5 East
//
// P0 sends on C0. An even PE receives on C1 and sends on C0; an odd PE
// receives on C0 and sends on C1. The last PE only receives.
comptime {
    if (first_px) {
        @set_local_color_config(c_send_east, .{ .routes = .{ .rx = .{RAMP}, .tx = .{EAST} } } );
    } else if (last_px) {
        @set_local_color_config(c_recv_west, .{ .routes = .{ .rx = .{WEST}, .tx = .{RAMP} } } );
    } else {
        @set_local_color_config(c_recv_west, .{ .routes = .{ .rx = .{WEST}, .tx = .{RAMP} } } );
        @set_local_color_config(c_send_east, .{ .routes = .{ .rx = .{RAMP}, .tx = .{EAST} } } );
    }
}

// Westward on C2 and C3: receive from the east, send to the west.
//
//          C2     C3     C2     C3     C2
// West P0 <-- P1 <-- P2 <-- P3 <-- P4 <-- P5 East
//
// P0 only receives, on C2. An even PE receives on C2 and sends on C3; an
// odd PE receives on C3 and sends on C2.
comptime {
    if (first_px) {
        @set_local_color_config(c_recv_east, .{ .routes = .{ .rx = .{EAST}, .tx = .{RAMP} } } );
    } else if (last_px) {
        @set_local_color_config(c_send_west, .{ .routes = .{ .rx = .{RAMP}, .tx = .{WEST} } } );
    } else {
        @set_local_color_config(c_recv_east, .{ .routes = .{ .rx = .{EAST}, .tx = .{RAMP} } } );
        @set_local_color_config(c_send_west, .{ .routes = .{ .rx = .{RAMP}, .tx = .{WEST} } } );
    }
}

// Northward on C4 and C5: receive from the south, send to the north.
//
//           C4     C5     C4     C5     C4
// North P0 <-- P1 <-- P2 <-- P3 <-- P4 <-- P5 South
//
// P0 only receives, on C4. An even PE receives on C4 and sends on C5; an
// odd PE receives on C5 and sends on C4.
comptime {
    if (first_py) {
        @set_local_color_config(c_recv_south, .{ .routes = .{ .rx = .{SOUTH}, .tx = .{RAMP} } } );
    } else if (last_py) {
        @set_local_color_config(c_send_north, .{ .routes = .{ .rx = .{RAMP}, .tx = .{NORTH} } } );
    } else {
        @set_local_color_config(c_recv_south, .{ .routes = .{ .rx = .{SOUTH}, .tx = .{RAMP} } } );
        @set_local_color_config(c_send_north, .{ .routes = .{ .rx = .{RAMP}, .tx = .{NORTH} } } );
    }
}

// Southward on C6 and C7: receive from the north, send to the south.
//
//           C6     C7     C6     C7     C6
// North P0 --> P1 --> P2 --> P3 --> P4 --> P5 South
//
// P0 sends on C6. An even PE receives on C7 and sends on C6; an odd PE
// receives on C6 and sends on C7. The last PE only receives.
comptime {
    if (first_py) {
        @set_local_color_config(c_send_south, .{ .routes = .{ .rx = .{RAMP}, .tx = .{SOUTH} } } );
    } else if (last_py) {
        @set_local_color_config(c_recv_north, .{ .routes = .{ .rx = .{NORTH}, .tx = .{RAMP} } } );
    } else {
        @set_local_color_config(c_recv_north, .{ .routes = .{ .rx = .{NORTH}, .tx = .{RAMP} } } );
        @set_local_color_config(c_send_south, .{ .routes = .{ .rx = .{RAMP}, .tx = .{SOUTH} } } );
    }
}

// The queues are bound to their colors here, because the DSDs are loaded
// into explicit DSRs, for which the compiler does not configure the
// queues.
comptime {
    @initialize_queue(iq_recv_west, .{.color = c_recv_west});
    @initialize_queue(iq_recv_east, .{.color = c_recv_east});
    @initialize_queue(iq_recv_south, .{.color = c_recv_south});
    @initialize_queue(iq_recv_north, .{.color = c_recv_north});

    @initialize_queue(oq_send_east, .{.color = c_send_east});
    @initialize_queue(oq_send_west, .{.color = c_send_west});
    @initialize_queue(oq_send_north, .{.color = c_send_north});
    @initialize_queue(oq_send_south, .{.color = c_send_south});
}
