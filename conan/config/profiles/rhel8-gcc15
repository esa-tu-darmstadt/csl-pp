# RHEL 8 compatible binaries (glibc 2.28) built with GCC 15 and libstdc++.
# CI builds with gcc-toolset-15 on AlmaLinux 8; local builds must put a GCC 15
# gcc/g++ first on PATH. Conan does not verify the compiler version itself.
[settings]
os=Linux
os.distro=rhel8
arch=x86_64
compiler=gcc
compiler.version=15
compiler.libcxx=libstdc++11
compiler.cppstd=20
build_type=Release

[conf]
tools.cmake.cmaketoolchain:generator=Ninja
tools.build:compiler_executables={"c": "gcc", "cpp": "g++"}
