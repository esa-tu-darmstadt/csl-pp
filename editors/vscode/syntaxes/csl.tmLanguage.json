{
	"name": "CSL",
	"patterns": [
		{
			"begin": "//",
			"end": "$",
			"name": "comment.line.double-slash.csl"
		},
		{
			"match": "\\b(align|and|anytype|asm|break|comptime|const|continue|else|enum|export|extern|fn|for|if|layout|linkname|linksection|or|param|return|struct|switch|task|var|while|inline|volatile|noinline|async|await|suspend)\\b",
			"name": "keyword.control.csl"
		},
		{
			"match": "\\b(max_recursion_depth|stack_size)(?=\\s*\\()",
			"name": "keyword.control.csl"
		},
		{
			"match": "(@[A-Za-z_][A-Za-z0-9_]*)\\b",
			"name": "variable.language.csl"
		},
		{
			"match": "\\b([fiu](8|16|32|64))\\b",
			"name": "variable.storage.type.csl"
		},
		{
			"match": "\\b(bf16|cb16)\\b",
			"name": "variable.storage.type.csl"
		},
		{
			"match": "\\b(data_task_id|control_task_id|local_task_id)\\b",
			"name": "variable.storage.type.csl"
		},
		{
			"match": "\\b(bool)\\b",
			"name": "variable.storage.type.csl"
		},
		{
			"match": "(?<!\\.)\\b(void|type|color|input_queue|output_queue|ut_id|direction|imported_module|mem1d_dsd|mem4d_dsd|fabin_dsd|fabout_dsd|fifo_handle|dsr_dest|dsr_src0|dsr_src1|dsr_fifo_dest|dsr_fifo_src1|xdsr|sr)\\b(?!\\s*:)",
			"name": "variable.storage.type.csl"
		},
		{
			"match": "\\bcomptime_(int|float|string|struct)\\b",
			"name": "variable.storage.type.csl"
		},
		{
			"match": "\\b(false|true|EAST|WEST|NORTH|SOUTH|RAMP)\\b",
			"name": "constant.language.csl"
		},
		{
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{
					"name": "constant.character.escape.csl",
					"match": "\\\\."
				}
			],
			"name": "string.quoted.double.csl"
		},
		{
			"begin": "'",
			"end": "'",
			"patterns": [
				{
					"name": "constant.character.escape.csl",
					"match": "\\\\."
				}
			],
			"name": "string.quoted.single.csl"
		},
		{
			"match": "\\b([0-9]+(\\.[0-9])?+([eE][+-]?[0-9]+))\\b",
			"name": "constant.numeric.csl"
		},
		{
			"match": "\\b(0x[0-9a-fA-F]+)\\b",
			"name": "constant.numeric.csl"
		},
		{
			"match": "\\b(0o[0-7]+)\\b",
			"name": "constant.numeric.csl"
		},
		{
			"match": "\\b(0b[01]+)\\b",
			"name": "constant.numeric.csl"
		},
		{
			"match": "\\b([0-9]+)\\b",
			"name": "constant.numeric.csl"
		}
	],
	"repository": {},
	"scopeName": "source.csl"
}