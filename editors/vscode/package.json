{
  "name": "csl-lsp",
  "displayName": "Language Server for CSL",
  "description": "Language server for the Cerebras Software Language (CSL) and csl++",
  "version": "0.0.0",
  "publisher": "esa-tu-darmstadt",
  "license": "Apache-2.0 WITH LLVM-exception",
  "repository": {
    "type": "git",
    "url": "https://github.com/esa-tu-darmstadt/csl-pp",
    "directory": "editors/vscode"
  },
  "bugs": {
    "url": "https://github.com/esa-tu-darmstadt/csl-pp/issues"
  },
  "homepage": "https://esa-tu-darmstadt.github.io/csl-pp/tools/vscode/",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "csl.restartServer",
        "title": "CSL: Restart Language Server"
      }
    ],
    "languages": [
      {
        "id": "csl",
        "aliases": [
          "CSL",
          "Cerebras Software Language"
        ],
        "extensions": [
          ".csl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "csl",
        "scopeName": "source.csl",
        "path": "./syntaxes/csl.tmLanguage.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "CSL",
      "properties": {
        "csl.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path of the csl-lsp-server to run. If empty, the extension runs the server that it contains."
        },
        "csl.serverArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Further command-line arguments of csl-lsp-server."
        },
        "csl.arch": {
          "type": "string",
          "enum": [
            "wse2",
            "wse3"
          ],
          "default": "wse2",
          "description": "The target architecture."
        },
        "csl.systemImportPath": {
          "type": "string",
          "default": "",
          "description": "A directory with the system modules of the SDK, which are imported with angle brackets, as in <memcpy/memcpy>. If csl.systemModuleSif is set, this is the directory of the system modules within the image; leave it empty to use the default directory of the SDK."
        },
        "csl.systemModuleSif": {
          "type": "string",
          "default": "",
          "description": "Path of the SDK image (*.sif) from which the server reads the system modules, such as <memcpy/memcpy>. Go to definition opens them as read-only documents."
        },
        "csl.rectangle": {
          "type": "string",
          "default": "100,100",
          "description": "The size of the program rectangle that @get_rectangle returns, as width,height."
        },
        "csl.fabricDims": {
          "type": "string",
          "default": "100,100",
          "description": "The fabric dimensions, as width,height."
        },
        "csl.fabricOffsets": {
          "type": "string",
          "default": "3,3",
          "description": "The offset of the program rectangle in the fabric, as x,y."
        },
        "csl.params": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          },
          "default": {},
          "description": "The values of the param declarations of the layout file, like --params of csl-pp. A number with a decimal point is a comptime_float, any other number a comptime_int. Example: {\"width\": 4, \"N\": 8}."
        },
        "csl.filterOverlappingErrors": {
          "type": "boolean",
          "default": false,
          "description": "If several errors overlap, show only the innermost one."
        },
        "csl.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Log the messages between VS Code and the language server."
        }
      }
    }
  },
  "scripts": {
    "compile": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node",
    "watch": "npm run compile -- --watch",
    "package": "vsce package --target",
    "package:linux-x64": "vsce package --target linux-x64",
    "package:linux-arm64": "vsce package --target linux-arm64",
    "package:darwin-x64": "vsce package --target darwin-x64",
    "package:darwin-arm64": "vsce package --target darwin-arm64"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^25.1.0",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.27.2",
    "typescript": "^5.3.0"
  }
}